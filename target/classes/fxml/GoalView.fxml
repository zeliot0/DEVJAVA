<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:controller="tn.esprit.controllers.GoalController"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            styleClass="root-pane">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="18" styleClass="topbar">
            <VBox spacing="3">
                <Label text="Goals Dashboard" styleClass="top-title"/>
                <Label text="Manage your goals and milestones with the NEXA design" styleClass="top-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Refresh" onAction="#refreshGoals" styleClass="btn-secondary"/>
            <Button text="Clear Goal Form" onAction="#clearGoalForm" styleClass="btn-outline"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="form-scroll">
            <content>
                <VBox spacing="20" style="-fx-padding: 24;">
                    <HBox spacing="16">
                        <VBox prefWidth="250" spacing="8" styleClass="stat-card">
                            <Label text="TOTAL GOALS" styleClass="stat-label"/>
                            <Label fx:id="lblTotalGoals" text="0" styleClass="stat-value"/>
                        </VBox>
                        <VBox prefWidth="250" spacing="8" styleClass="stat-card">
                            <Label text="ACTIVE GOALS" styleClass="stat-label"/>
                            <Label fx:id="lblActiveGoals" text="0" styleClass="stat-value"/>
                        </VBox>
                        <VBox prefWidth="250" spacing="8" styleClass="stat-card">
                            <Label text="COMPLETED GOALS" styleClass="stat-label"/>
                            <Label fx:id="lblCompletedGoals" text="0" styleClass="stat-value"/>
                        </VBox>
                        <VBox prefWidth="250" spacing="8" styleClass="stat-card">
                            <Label text="AVG. PROGRESS" styleClass="stat-label"/>
                            <Label fx:id="lblAverageProgress" text="0 %" styleClass="stat-value"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="20">
                        <VBox prefWidth="470" spacing="16" styleClass="panel">
                            <VBox spacing="4">
                                <Label text="Goal Form" styleClass="panel-title"/>
                                <Label text="Add, update and manage goal data" styleClass="panel-sub"/>
                            </VBox>

                            <Separator/>

                            <VBox spacing="8">
                                <Label text="ID" styleClass="field-lbl"/>
                                <TextField fx:id="tfId" editable="false" promptText="Auto generated" styleClass="nexa-field"/>
                            </VBox>

                            <VBox spacing="8">
                                <Label text="Title" styleClass="field-lbl"/>
                                <TextField fx:id="tfTitle" promptText="Enter goal title" styleClass="nexa-field"/>
                            </VBox>

                            <VBox spacing="8">
                                <Label text="Description" styleClass="field-lbl"/>
                                <TextArea fx:id="taDescription" promptText="Enter description" prefRowCount="3" styleClass="nexa-field"/>
                            </VBox>

                            <HBox spacing="14">
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <Label text="Start Date" styleClass="field-lbl"/>
                                    <DatePicker fx:id="dpStartDate" styleClass="nexa-date"/>
                                </VBox>
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <Label text="End Date" styleClass="field-lbl"/>
                                    <DatePicker fx:id="dpEndDate" styleClass="nexa-date"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="14">
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <Label text="Status" styleClass="field-lbl"/>
                                    <ComboBox fx:id="cbStatus" promptText="Choose status" styleClass="nexa-combo"/>
                                </VBox>
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <Label text="Priority" styleClass="field-lbl"/>
                                    <ComboBox fx:id="cbPriority" promptText="Choose priority" styleClass="nexa-combo"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="14">
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <Label text="Progress %" styleClass="field-lbl"/>
                                    <TextField fx:id="tfProgress" promptText="0 - 100" styleClass="nexa-field"/>
                                </VBox>
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <Label text="Category" styleClass="field-lbl"/>
                                    <TextField fx:id="tfCategory" promptText="Example: Career" styleClass="nexa-field"/>
                                </VBox>
                            </HBox>

                            <VBox spacing="8">
                                <Label text="Notes" styleClass="field-lbl"/>
                                <TextArea fx:id="taNotes" promptText="Extra notes" prefRowCount="3" styleClass="nexa-field"/>
                            </VBox>

                            <VBox spacing="8">
                                <Label text="Color" styleClass="field-lbl"/>
                                <ColorPicker fx:id="colorPicker"/>
                            </VBox>

                            <HBox spacing="10">
                                <Button text="Add Goal" onAction="#addGoal" styleClass="btn-primary"/>
                                <Button text="Update Goal" onAction="#updateGoal" styleClass="btn-secondary"/>
                                <Button text="Delete Goal" onAction="#deleteGoal" styleClass="btn-danger"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="20" HBox.hgrow="ALWAYS">
                            <VBox spacing="16" styleClass="panel" VBox.vgrow="ALWAYS">
                                <VBox spacing="4">
                                    <Label text="Goals List" styleClass="panel-title"/>
                                    <Label text="Search and filter your goals" styleClass="panel-sub"/>
                                </VBox>

                                <HBox spacing="10">
                                    <TextField fx:id="tfSearchGoal" promptText="Search by title, description, status, category..." styleClass="nexa-field" HBox.hgrow="ALWAYS"/>
                                    <ComboBox fx:id="cbFilterStatus" promptText="Status" styleClass="nexa-combo"/>
                                    <ComboBox fx:id="cbFilterPriority" promptText="Priority" styleClass="nexa-combo"/>
                                    <ComboBox fx:id="cbFilterCategory" promptText="Category" styleClass="nexa-combo"/>
                                    <Button text="Reset" onAction="#resetFilters" styleClass="btn-outline"/>
                                </HBox>

                                <TableView fx:id="tableGoals" styleClass="nexa-table" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                                        <TableColumn fx:id="colTitle" text="Title" prefWidth="160"/>
                                        <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
                                        <TableColumn fx:id="colProgress" text="Progress" prefWidth="100"/>
                                        <TableColumn fx:id="colCategory" text="Category" prefWidth="120"/>
                                        <TableColumn fx:id="colPriority" text="Priority" prefWidth="100"/>
                                        <TableColumn fx:id="colStartDate" text="Start Date" prefWidth="110"/>
                                        <TableColumn fx:id="colEndDate" text="End Date" prefWidth="110"/>
                                    </columns>
                                </TableView>
                            </VBox>

                            <VBox spacing="16" styleClass="panel">
                                <VBox spacing="4">
                                    <Label fx:id="lblSelectedGoal" text="Milestones for: no goal selected" styleClass="panel-title"/>
                                    <Label text="Each milestone belongs to the selected goal" styleClass="panel-sub"/>
                                </VBox>

                                <HBox spacing="16">
                                    <VBox spacing="10" prefWidth="360">
                                        <VBox spacing="8">
                                            <Label text="Milestone ID" styleClass="field-lbl"/>
                                            <TextField fx:id="tfMilestoneId" editable="false" promptText="Auto generated" styleClass="nexa-field"/>
                                        </VBox>

                                        <VBox spacing="8">
                                            <Label text="Milestone Title" styleClass="field-lbl"/>
                                            <TextField fx:id="tfMilestoneTitle" promptText="Enter milestone title" styleClass="nexa-field"/>
                                        </VBox>

                                        <VBox spacing="8">
                                            <Label text="Description" styleClass="field-lbl"/>
                                            <TextArea fx:id="taMilestoneDescription" prefRowCount="3" promptText="Enter milestone description" styleClass="nexa-field"/>
                                        </VBox>

                                        <VBox spacing="8">
                                            <Label text="Due Date" styleClass="field-lbl"/>
                                            <DatePicker fx:id="dpMilestoneDueDate" styleClass="nexa-date"/>
                                        </VBox>

                                        <CheckBox fx:id="chkMilestoneCompleted" text="Completed" styleClass="nexa-check"/>

                                        <HBox spacing="10">
                                            <Button text="Add Milestone" onAction="#addMilestone" styleClass="btn-primary"/>
                                            <Button text="Update" onAction="#updateMilestone" styleClass="btn-secondary"/>
                                            <Button text="Delete" onAction="#deleteMilestone" styleClass="btn-danger"/>
                                            <Button text="Clear" onAction="#clearMilestoneForm" styleClass="btn-outline"/>
                                        </HBox>
                                    </VBox>

                                    <VBox HBox.hgrow="ALWAYS">
                                        <TableView fx:id="tableMilestones" styleClass="nexa-table" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colMilestoneId" text="ID" prefWidth="55"/>
                                                <TableColumn fx:id="colMilestoneTitle" text="Title" prefWidth="150"/>
                                                <TableColumn fx:id="colMilestoneDescription" text="Description" prefWidth="220"/>
                                                <TableColumn fx:id="colMilestoneDueDate" text="Due Date" prefWidth="120"/>
                                                <TableColumn fx:id="colMilestoneCompleted" text="Done" prefWidth="80"/>
                                            </columns>
                                        </TableView>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </VBox>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
