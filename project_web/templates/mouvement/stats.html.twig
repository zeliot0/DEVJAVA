{% extends 'base.html.twig' %}

{% set body_class = 'conscience-page' %}

{% block title %}Analyses Flux - NEXA Workspace{% endblock %}

{% block breadcrumb_current %}Analyses Mouvements{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/nexa-conscience-notion.css?v=' ~ 'now'|date('U')) }}">
    <style>
        .stats-container {
            max-width: 900px;
            margin: 0 auto;
            padding: 40px 20px;
        }
        .dist-row {
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 12px 0;
            border-bottom: 1px solid var(--notion-border);
        }
        .dist-label {
            width: 140px;
            font-size: 14px;
            font-weight: 600;
            color: var(--notion-text);
        }
        .dist-progress-box {
            flex: 1;
            height: 8px;
            background: #f1f1ef;
            border-radius: 4px;
            overflow: hidden;
        }
        .dist-progress-fill {
            height: 100%;
            background: var(--notion-accent);
            border-radius: 4px;
        }
        .dist-value {
            width: 100px;
            text-align: right;
            font-size: 13px;
            color: var(--notion-text-muted);
        }
    </style>
{% endblock %}

{% block body %}
<div class="stats-container">
    <header class="conscience-header" style="margin-bottom: 48px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-end;">
            <div>
                <h1 style="font-size: 32px; font-weight: 700; margin: 0;">Analyse des flux</h1>
                <p style="color: var(--notion-text-muted); margin-top: 8px;">Répartition des entrées et sorties de stock.</p>
            </div>
            <div style="display: flex; gap: 12px;">
                <a href="{{ path('app_mouvement_index') }}" class="btn">
                    <i class="fa-solid fa-arrow-left"></i> Retour
                </a>
                <a href="{{ path('app_mouvement_pdf') }}" class="btn primary">
                    <i class="fa-solid fa-file-pdf"></i> Exporter
                </a>
            </div>
        </div>
    </header>

    <!-- Global KPI -->
    <div class="produit-stats-grid" style="margin-bottom: 64px;">
        <div class="stat-card">
            <span class="label">Total opérations</span>
            <div class="value">{{ totalMouvements }}</div>
            <div class="detail">Flux enregistrés</div>
        </div>
        <div class="stat-card">
            <span class="label">Volume brassé</span>
            <div class="value">{{ totalQuantite }}</div>
            <div class="detail">Unités déplacées</div>
        </div>
    </div>

    <!-- Type Distribution -->
    <section>
        <div class="notion-section-title" style="margin-bottom: 24px;">
            <i class="fa-solid fa-chart-pie"></i> Répartition par type de flux
        </div>

        <div style="background: #fff; border: 1px solid var(--notion-border); border-radius: 12px; padding: 24px;">
            {% for row in stats %}
                {% set value = row.totalQuantite|default(0) %}
                {% set percent = maxTotalQuantite > 0 ? (value / maxTotalQuantite * 100) : 0 %}
                
                <div class="dist-row">
                    <div class="dist-label">
                        {% if row.type == 'ENTREE' %}
                            <i class="fa-solid fa-arrow-down" style="color: #166534; width: 16px;"></i> Entrée
                        {% else %}
                            <i class="fa-solid fa-arrow-up" style="color: #9f1239; width: 16px;"></i> Sortie
                        {% endif %}
                    </div>
                    <div class="dist-progress-box">
                        <div class="dist-progress-fill" style="width: {{ percent }}%; background: {{ row.type == 'ENTREE' ? '#166534' : '#9f1239' }};"></div>
                    </div>
                    <div class="dist-value">
                        <strong>{{ value }}</strong> <span style="font-size: 11px;">({{ row.totalMouvements }} op.)</span>
                    </div>
                </div>
            {% else %}
                <div style="text-align: center; color: var(--notion-text-muted); padding: 40px;">
                    Aucune donnée disponible.
                </div>
            {% endfor %}
        </div>
    </section>
</div>
{% endblock %}



