{% extends 'base.html.twig' %}

{% set body_class = 'conscience-page' %}

{% block title %}NOUVEAU FLUX — NEXA Intelligence{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/conscience-modern-proo.css?v=' ~ 'now'|date('U')) }}">
{% endblock %}

{% block body %}
<div class="conscience-modern-page">
    <header class="conscience-page-header">
        <h1>Initialisation de Flux</h1>
        <p>Définition d'un mouvement de stock pour le maintien de l'équilibre logistique.</p>
    </header>

    <div class="conscience-header-actions" style="margin-bottom: 48px;">
        <div class="page-actions">
            <a href="{{ path('app_mouvement_index') }}" class="btn">
                ← Retour au Rapport de Flux
            </a>
        </div>
    </div>

    {{ include('mouvement/_form.html.twig', {'button_label': 'Confirmer l\'Opération'}) }}
</div>
{% endblock %}
