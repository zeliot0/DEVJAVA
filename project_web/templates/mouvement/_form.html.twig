{{ form_start(form, { attr: { novalidate: 'novalidate', class: 'conscience-modern-form' } }) }}

<div class="form-container-inner">
    {% if form.vars.submitted and not form.vars.valid %}
        <div class="form-error-summary">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span>Défaut de synchronisation détecté dans les données de flux.</span>
        </div>
    {% endif %}

    <div class="form-grid">
        <!-- Section 1: Produit et Type -->
        <div class="form-section-card">
            <div class="section-badge highlight">01. CIBLE ET NATURE</div>
            <div class="section-description">Sélection de la ressource et définition du sens de circulation.</div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <div class="pg-field">
                    {{ form_label(form.produit, 'Vecteur Source *', {'label_attr': {'class': 'pg-label'}}) }}
                    {{ form_widget(form.produit, {'attr': {'class': 'pg-select'}}) }}
                    {{ form_errors(form.produit) }}
                </div>
                <div class="pg-field">
                    {{ form_label(form.type_m, 'Classification du Flux *', {'label_attr': {'class': 'pg-label'}}) }}
                    {{ form_widget(form.type_m, {'attr': {'class': 'pg-select'}}) }}
                    {{ form_errors(form.type_m) }}
                </div>
            </div>
        </div>

        <!-- Section 2: Détails -->
        <div class="form-section-card">
            <div class="section-badge info">02. PARAMÈTRES DU FLUX</div>
            <div class="section-description">Amplitude et chronologie de l'événement logistique.</div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <div class="pg-field">
                    {{ form_label(form.quantite, 'Amplitude (Quantité) *', {'label_attr': {'class': 'pg-label'}}) }}
                    {{ form_widget(form.quantite, {'attr': {'class': 'pg-input', 'placeholder': 'Ex: 10'}}) }}
                    {{ form_errors(form.quantite) }}
                </div>
                <div class="pg-field">
                    {{ form_label(form.date_mouvement, 'Pulsation (Date) *', {'label_attr': {'class': 'pg-label'}}) }}
                    {{ form_widget(form.date_mouvement, {'attr': {'class': 'pg-input'}}) }}
                    {{ form_errors(form.date_mouvement) }}
                </div>
            </div>

            <div class="pg-field">
                {{ form_label(form.motif, 'Justification Structurelle *', {'label_attr': {'class': 'pg-label'}}) }}
                {{ form_widget(form.motif, {'attr': {'class': 'pg-textarea', 'placeholder': 'Ex: Réallocation stratégique, Acquisition...'}}) }}
                {{ form_errors(form.motif) }}
            </div>
        </div>
    </div>

    <div class="form-persistence-bar">
        <a href="{{ path('app_mouvement_index') }}" class="btn">
            Interrompre
        </a>
        <button type="submit" class="btn primary">
            {{ button_label|default('Enregistrer le flux') }}
        </button>
    </div>
</div>

{{ form_end(form) }}
