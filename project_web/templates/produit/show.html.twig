{% extends 'base.html.twig' %}

{% set body_class = 'conscience-page' %}

{% block title %}FICHE TECHNIQUE : {{ produit.nomP }} — NEXA Intelligence{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/conscience-modern-proo.css?v=' ~ 'now'|date('U')) }}">
    <style>
        .p-show-hero { display: grid; grid-template-columns: 280px 1fr; gap: 48px; margin-bottom: 48px; align-items: start; }
        .p-show-img-box { width: 280px; height: 280px; border-radius: 16px; overflow: hidden; border: 1px solid #efefef; background: white; display: flex; align-items: center; justify-content: center; position: relative; }
        .p-show-img { width: 100%; height: 100%; object-fit: cover; }
        
        .p-prop-list { margin-top: 24px; }
        .p-prop-row { display: grid; grid-template-columns: 160px 1fr; padding: 12px 0; border-bottom: 1px solid #f8fafc; }
        .p-prop-row:last-child { border-bottom: none; }
        .p-prop-k { font-size: 11px; font-weight: 700; color: var(--notion-text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
        .p-prop-v { font-size: 14px; font-weight: 600; color: var(--notion-text); }
        
        .history-card { background: white; border: 1px solid #efefef; border-radius: 12px; overflow: hidden; }
        .h-row { display: flex; justify-content: space-between; align-items: center; padding: 16px 24px; border-bottom: 1px solid #f8fafc; transition: background 0.2s; }
        .h-row:hover { background: #fcfcfc; }
        .h-row:last-child { border-bottom: none; }
        
        .type-indicator { font-size: 10px; font-weight: 800; padding: 2px 8px; border-radius: 4px; text-transform: uppercase; }
        .ind-in { background: #dcfce7; color: #166534; }
        .ind-out { background: #fef2f2; color: #991b1b; }
    </style>
{% endblock %}

{% block body %}
<div class="conscience-modern-page">

    <header class="conscience-page-header">
        <h1>Vecteur Logistique : {{ produit.nomP }}</h1>
        <p>Analyse structurelle et historique des flux pour la référence <strong>#{{ produit.idP }}</strong></p>
    </header>

    <div class="conscience-header-actions" style="margin-bottom: 40px;">
        <div class="page-actions">
            <a href="{{ path('app_produit_index') }}" class="btn">
                ← Retour au Répertoire
            </a>
            {% if not is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_mouvement_new', {'id_p': produit.idP}) }}" class="btn">
                    Enregistrer Flux
                </a>
                <a href="{{ path('app_produit_edit', {'id_p': produit.idP}) }}" class="btn">
                    Mise à jour Fiche
                </a>
            {% endif %}
        </div>
    </div>

    <div class="p-show-hero">
        <div class="p-show-img-box">
            {% if produit.photoP %}
                <img src="{{ (produit.photoP starts with 'http') ? produit.photoP : asset('uploads/produits/' ~ produit.photoP) }}" class="p-show-img">
            {% else %}
                <div style="font-size: 80px; color: #e2e8f0;"><i class="fa-solid fa-box"></i></div>
            {% endif %}
        </div>

        <div class="p-show-info">
            <div style="display: flex; align-items: baseline; gap: 16px; margin-bottom: 24px;">
                {% set stock = produit.quantiteStock ?? 0 %}
                <div style="font-size: 32px; font-weight: 800; color: var(--notion-text);">{{ stock }} <span style="font-size: 14px; font-weight: 600; color: var(--notion-text-muted);">{{ produit.uniteP }} en réserve</span></div>
                {% set statusClass = stock < 5 ? 'critical' : (stock < 15 ? 'warn' : 'good') %}
                <span class="detail-badge {{ statusClass }}" style="font-size: 11px; padding: 4px 12px;">
                    {{ stock < 5 ? 'ALERTE RUPTURE' : (stock < 15 ? 'STOCK FAIBLE' : 'VOLUME STABLE') }}
                </span>
            </div>

            <div class="section-title" style="margin-bottom: 16px; font-size: 11px; font-weight: 700; color: #3b82f6; text-transform: uppercase;">Paramètres Techniques</div>
            
            <div class="p-prop-list">
                <div class="p-prop-row">
                    <div class="p-prop-k">Catégorie</div>
                    <div class="p-prop-v">{{ produit.categorieP ?: 'Non classifié' }}</div>
                </div>
                <div class="p-prop-row">
                    <div class="p-prop-k">Zone de Stockage</div>
                    <div class="p-prop-v">{{ produit.emplacement ?: 'N/A' }}</div>
                </div>
                <div class="p-prop-row">
                    <div class="p-prop-k">Enregistré le</div>
                    <div class="p-prop-v">{{ produit.dateAjout ? produit.dateAjout|date('d F Y') : 'Date inconnue' }}</div>
                </div>
                <div class="p-prop-row">
                    <div class="p-prop-k">Expiration Cible</div>
                    <div class="p-prop-v" style="{{ produit.dateExpiration and produit.dateExpiration < date() ? 'color: #ef4444;' : '' }}">
                        {{ produit.dateExpiration ? produit.dateExpiration|date('d F Y') : 'Pas de date limite' }}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <section style="margin-top: 64px;">
        <div class="section-title" style="margin-bottom: 24px; font-size: 11px; font-weight: 700; color: #10b981; text-transform: uppercase; border-left: 3px solid #10b981; padding-left: 10px; background: rgba(16, 185, 129, 0.05);">Journal des Flux Récents</div>

        <div class="history-card">
            {% for mouvement in mouvements %}
                <div class="h-row">
                    <div style="display: flex; align-items: center; gap: 20px;">
                        <span class="type-indicator {{ mouvement.typeM == 'ENTREE' ? 'ind-in' : 'ind-out' }}">
                            {{ mouvement.typeM == 'ENTREE' ? 'ACQUISITION' : 'DÉPLOIEMENT' }}
                        </span>
                        <div>
                            <div style="font-size: 14px; font-weight: 700; color: var(--notion-text);">{{ mouvement.quantite }} {{ produit.uniteP }}</div>
                            <div style="font-size: 11px; font-weight: 600; color: var(--notion-text-muted);">{{ mouvement.motif ?: 'Aucune note' }}</div>
                        </div>
                    </div>
                    <div style="font-size: 13px; font-weight: 600; color: #94a3b8;">
                        {{ mouvement.dateMouvement ? mouvement.dateMouvement|date('d M Y') : '—' }}
                    </div>
                </div>
            {% else %}
                <div style="padding: 60px; text-align: center; color: var(--notion-text-muted);">
                    <i class="fa-solid fa-hourglass-empty" style="font-size: 32px; margin-bottom: 16px; opacity: 0.3;"></i>
                    <p style="font-size: 14px; font-style: italic;">Aucune fluctuation tectonique de stock pour cette référence.</p>
                </div>
            {% endfor %}
            
            {% if mouvements|length > 0 %}
                <div style="padding: 16px; text-align: center; background: #fcfcfc; border-top: 1px solid #f8fafc;">
                    <a href="{{ path('app_mouvement_index', {'id_p': produit.idP}) }}" style="font-size: 11px; font-weight: 700; color: #3b82f6; text-decoration: none; text-transform: uppercase;">Voir l'historique complet</a>
                </div>
            {% endif %}
        </div>
    </section>

    {% if not is_granted('ROLE_ADMIN') %}
        <div style="margin-top: 80px; padding-top: 32px; border-top: 1px solid #efefef; text-align: right;">
            {{ include('produit/_delete_form.html.twig') }}
        </div>
    {% endif %}

</div>
{% endblock %}
