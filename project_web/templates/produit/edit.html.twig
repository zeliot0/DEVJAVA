{% extends 'base.html.twig' %}

{% set body_class = 'conscience-page' %}

{% block title %}MISE À JOUR : {{ produit.nomP }} — NEXA Intelligence{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/conscience-modern-proo.css?v=' ~ 'now'|date('U')) }}">
{% endblock %}

{% block body %}
<div class="conscience-modern-page">
    <header class="conscience-page-header">
        <h1>Modification de Vecteur</h1>
        <p>Ajustement des paramètres structurels pour la référence <strong>#{{ produit.idP }}</strong></p>
    </header>

    <div class="conscience-header-actions" style="margin-bottom: 48px;">
        <div class="page-actions">
            <a href="{{ path('app_produit_show', {id_p: produit.idP}) }}" class="btn">
                ← Retour à la Fiche Detail
            </a>
            {% if not is_granted('ROLE_ADMIN') %}
                <div style="margin-left: auto;">
                    {{ include('produit/_delete_form.html.twig') }}
                </div>
            {% endif %}
        </div>
    </div>

    {{ include('produit/_form.html.twig', {'button_label': 'Appliquer les Mutations'}) }}
</div>
{% endblock %}
