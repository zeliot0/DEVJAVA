{% extends 'base.html.twig' %}

{% set body_class = 'conscience-page' %}

{% block title %}NOUVELLE RÉFÉRENCE — NEXA Intelligence{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/conscience-modern-proo.css?v=' ~ 'now'|date('U')) }}">
{% endblock %}

{% block body %}
<div class="conscience-modern-page">
    <header class="conscience-page-header">
        <h1>Instanciation de Produit</h1>
        <p>Enregistrement d'un nouveau vecteur logistique dans la matrice opérationnelle.</p>
    </header>

    <div class="conscience-header-actions" style="margin-bottom: 48px;">
        <div class="page-actions">
            <a href="{{ path('app_produit_index') }}" class="btn">
                ← Retour au Répertoire
            </a>
        </div>
    </div>

    {{ include('produit/_form.html.twig', {'button_label': 'Confirmer l\'Instanciation'}) }}
</div>
{% endblock %}
