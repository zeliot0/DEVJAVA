{{ form_start(form, { attr: { novalidate: 'novalidate', class: 'conscience-modern-form' } }) }}

<div class="form-container-inner">
    {% if form.vars.submitted and not form.vars.valid %}
        <div class="form-error-summary">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span>Des ajustements structurels sont nécessaires dans le formulaire.</span>
        </div>
    {% endif %}

    <div class="form-grid">
        <!-- Section 1: Identification -->
        <div class="form-section-card">
            <div class="section-badge highlight">01. IDENTIFICATION</div>
            <div class="section-description">Paramètres nominatifs et classification du vecteur logistique.</div>
            
            <div class="pg-field">
                {{ form_label(form.nom_p, 'Désignation du produit *', {'label_attr': {'class': 'pg-label'}}) }}
                {{ form_widget(form.nom_p, {'attr': {'class': 'pg-input', 'placeholder': 'Ex: Unité de stockage Helium'}}) }}
                {{ form_errors(form.nom_p) }}
            </div>

            <div class="pg-field">
                {{ form_label(form.categorie_p, 'Domaine / Catégorie', {'label_attr': {'class': 'pg-label'}}) }}
                {{ form_widget(form.categorie_p, {'attr': {'class': 'pg-input', 'placeholder': 'Ex: Matériel, Logistique...'}}) }}
                {{ form_errors(form.categorie_p) }}
            </div>
        </div>

        <!-- Section 2: Inventaire -->
        <div class="form-section-card">
            <div class="section-badge info">02. LOGISTIQUE</div>
            <div class="section-description">État des réserves et localisation spatiale de la référence.</div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <div class="pg-field">
                    {{ form_label(form.quantite_stock, 'Volume Initial', {'label_attr': {'class': 'pg-label'}}) }}
                    {{ form_widget(form.quantite_stock, {'attr': {'class': 'pg-input'}}) }}
                    {{ form_errors(form.quantite_stock) }}
                </div>
                <div class="pg-field">
                    {{ form_label(form.unite_p, 'Unité de Mesure', {'label_attr': {'class': 'pg-label'}}) }}
                    {{ form_widget(form.unite_p, {'attr': {'class': 'pg-input', 'placeholder': 'Ex: kg, litres...'}}) }}
                    {{ form_errors(form.unite_p) }}
                </div>
            </div>

            <div class="pg-field">
                {{ form_label(form.emplacement, 'Zone d\'affectation', {'label_attr': {'class': 'pg-label'}}) }}
                {{ form_widget(form.emplacement, {'attr': {'class': 'pg-input', 'placeholder': 'Ex: Secteur A, Étagère 4'}}) }}
                {{ form_errors(form.emplacement) }}
            </div>
        </div>

        <!-- Section 3: Chronologie -->
        <div class="form-section-card">
            <div class="section-badge timeline">03. CHRONOLOGIE</div>
            <div class="section-description">Cycles de vie et marqueurs temporels du produit.</div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <div class="pg-field">
                    {{ form_label(form.date_ajout, 'Date d\'Enregistrement', {'label_attr': {'class': 'pg-label'}}) }}
                    {{ form_widget(form.date_ajout, {'attr': {'class': 'pg-input'}}) }}
                    {{ form_errors(form.date_ajout) }}
                </div>
                <div class="pg-field">
                    {{ form_label(form.date_expiration, 'Date de Péremption', {'label_attr': {'class': 'pg-label'}}) }}
                    {{ form_widget(form.date_expiration, {'attr': {'class': 'pg-input'}}) }}
                    {{ form_errors(form.date_expiration) }}
                </div>
            </div>
        </div>

        <!-- Section 4: Visuel -->
        <div class="form-section-card">
            <div class="section-badge visual">04. VISUEL</div>
            <div class="section-description">Représentation iconographique de la ressource.</div>
            
            <div class="pg-field">
                {{ form_label(form.photo_p, 'Capture Optique (Image)', {'label_attr': {'class': 'pg-label'}}) }}
                {{ form_widget(form.photo_p, {'attr': {'class': 'pg-input-file'}}) }}
                <div class="form-help-text">Formats : JPG, PNG, WEBP — Limite : 2 Mo.</div>
                {{ form_errors(form.photo_p) }}
            </div>
        </div>
    </div>

    <div class="form-persistence-bar">
        <a href="{{ path('app_produit_index') }}" class="btn">
            Interrompre
        </a>
        <button type="submit" class="btn primary">
            {{ button_label|default('Enregistrer le vecteur') }}
        </button>
    </div>
</div>

{{ form_end(form) }}
