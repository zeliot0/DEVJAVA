{% extends 'base.html.twig' %}

{% set body_class = 'conscience-page' %}

{% block title %}TRACE EXE-{{ execution.idExe }} — NEXA Intelligence{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/execution-modern.css?v=' ~ 'now'|date('U')) }}">
{% endblock %}

{% block body %}
<div class="exe-page">

    <header class="exe-header">
        <div>
            <div style="font-size: 11px; font-weight: 800; color: var(--notion-text-muted); text-transform: uppercase; letter-spacing: 0.2em; margin-bottom: 8px;">Analyse de Processus</div>
            <h1 class="exe-title"><i class="fa-solid fa-terminal"></i> Instance #{{ execution.idExe }}</h1>
        </div>
        <div style="display: flex; gap: 12px;">
            <a href="{{ path('app_execution_index') }}" class="btn">
                <i class="fas fa-arrow-left"></i> Flux
            </a>
            <a href="{{ path('app_execution_edit', {'id_exe': execution.idExe}) }}" class="btn">
                <i class="fas fa-pen"></i> Rectification
            </a>
        </div>
    </header>

    <div class="exe-detail-card">
        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 40px; margin-bottom: 48px;">
            <div>
                <label style="font-size: 11px; font-weight: 800; color: var(--notion-text-muted); text-transform: uppercase; letter-spacing: 0.1em; display: block; margin-bottom: 12px;">Désignation de la Tâche</label>
                <div style="font-size: 24px; font-weight: 800; color: #111827;">{{ execution.titleExe }}</div>
            </div>
            <div style="text-align: right;">
                <label style="font-size: 11px; font-weight: 800; color: var(--notion-text-muted); text-transform: uppercase; letter-spacing: 0.1em; display: block; margin-bottom: 12px;">État Actuel</label>
                {% set s = execution.statusExe|lower %}
                <span class="status-pill {% if s == 'success' or s == 'succès' or s == 'terminé' %}status-success{% elseif s == 'failed' or s == 'échec' %}status-failed{% else %}status-running{% endif %}" style="font-size: 14px; padding: 6px 16px;">
                    {{ execution.statusExe|default('EN COURS') }}
                </span>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px; margin-bottom: 48px; padding: 24px; background: #f9fafb; border-radius: 16px;">
            <div>
                <label style="font-size: 10px; font-weight: 800; color: var(--notion-text-muted); text-transform: uppercase; display: block; margin-bottom: 8px;">Initialisation</label>
                <div style="font-weight: 700;">{{ execution.createAtExe ? execution.createAtExe|date('d/m/Y H:i:s') : 'N/A' }}</div>
            </div>
            <div style="text-align: right;">
                <label style="font-size: 10px; font-weight: 800; color: var(--notion-text-muted); text-transform: uppercase; display: block; margin-bottom: 8px;">Dernière Mutation</label>
                <div style="font-weight: 700;">{{ execution.updateATExe ? execution.updateATExe|date('d/m/Y H:i:s') : 'N/A' }}</div>
            </div>
        </div>

        <label style="font-size: 11px; font-weight: 800; color: var(--notion-text-muted); text-transform: uppercase; letter-spacing: 0.1em; display: block; margin-bottom: 12px;">Flux de Données / Logs</label>
        <div class="exe-log-box">
            {{ execution.descExe|nl2br }}
            {% if not execution.descExe %}
                <span style="opacity: 0.5;">[AUCUNE DONNÉE DE SORTIE DISPONIBLE]</span>
            {% endif %}
        </div>

        <div style="margin-top: 48px; border-top: 1px solid #f3f4f6; padding-top: 32px; display: flex; justify-content: flex-end;">
            {{ include('execution/_delete_form.html.twig') }}
        </div>
    </div>

</div>
{% endblock %}
