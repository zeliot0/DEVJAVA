{% extends 'base.html.twig' %}

{% set body_class = 'conscience-page' %}

{% block title %}LOGS D'EXÉCUTION — NEXA Intelligence{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/execution-modern.css?v=' ~ 'now'|date('U')) }}">
{% endblock %}

{% block body %}
<div class="exe-page">

    <header class="exe-header">
        <div>
            <div style="font-size: 11px; font-weight: 800; color: #3b82f6; text-transform: uppercase; letter-spacing: 0.2em; margin-bottom: 8px;">Flux Opérationnel</div>
            <h1 class="exe-title">Journaux d'Exécution</h1>
            <p style="margin: 8px 0 0; font-size: 16px; color: var(--notion-text-muted);">Tracement en temps réel des macro-tâches et des processus système.</p>
        </div>
        <div class="page-actions">
            <a href="{{ path('app_execution_new') }}" class="btn primary" style="padding: 12px 24px; border-radius: 12px; font-weight: 700;">
                <i class="fas fa-plus"></i> Nouvelle Instance
            </a>
        </div>
    </header>

    <div class="exe-table-wrap">
        <table class="exe-table">
            <thead>
                <tr>
                    <th>ID INSTANCE</th>
                    <th>DÉSIGNATION</th>
                    <th>STATUT</th>
                    <th>HORODATAGE</th>
                    <th style="text-align: right;">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
            {% for item in executions %}
                <tr>
                    <td class="exe-id">#{{ item.idExe }}</td>
                    <td>
                        <div style="font-weight: 700; color: #111827;">{{ item.titleExe }}</div>
                        <div style="font-size: 12px; color: var(--notion-text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 300px;">{{ item.descExe }}</div>
                    </td>
                    <td>
                        {% set s = item.statusExe|lower %}
                        <span class="status-pill {% if s == 'success' or s == 'succès' or s == 'terminé' %}status-success{% elseif s == 'failed' or s == 'échec' %}status-failed{% else %}status-running{% endif %}">
                            {{ item.statusExe|default('EN COURS') }}
                        </span>
                    </td>
                    <td>
                        <div style="font-size: 13px; font-weight: 600;">{{ item.createAtExe ? item.createAtExe|date('d/m/Y') : 'N/A' }}</div>
                        <div style="font-size: 11px; color: var(--notion-text-muted);">{{ item.createAtExe ? item.createAtExe|date('H:i:s') : '' }}</div>
                    </td>
                    <td style="text-align: right;">
                        <a href="{{ path('app_execution_show', {'id_exe': item.idExe}) }}" class="btn" title="Inspecter">
                            <i class="fa-solid fa-terminal"></i>
                        </a>
                        <a href="{{ path('app_execution_edit', {'id_exe': item.idExe}) }}" class="btn" title="Modifier">
                            <i class="fa-solid fa-pen"></i>
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" style="text-align: center; padding: 60px; color: var(--notion-text-muted); font-style: italic;">
                        Aucune exécution enregistrée dans la matrice.
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

</div>
{% endblock %}
