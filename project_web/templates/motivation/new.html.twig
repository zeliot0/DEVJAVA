{% extends 'base.html.twig' %}

{% block title %}{{ motivation.id ? 'Modifier' : 'Nouvelle' }} Motivation - NEXA{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/motivation-form-premium.css') }}">
{% endblock %}

{% block body %}
<div class="motivation-form-page">
    <div class="motivation-form-container">
        <header class="motivation-form-header">
            <div class="motivation-kicker">Inspiration</div>
            <h1>
                {{ motivation.id ? 'Affiner la motivation' : 'Nouvelle motivation' }}
            </h1>
            <p>Infusez de l'énergie positive dans votre espace de travail.</p>
        </header>

        {{ form_start(form, {'attr': {'class': 'motivation-form'}}) }}
            <section class="motivation-form-section">
                <h2 class="motivation-section-title">
                    <i class="fa-solid fa-pen-nib"></i> Informations de la motivation
                </h2>

                <div class="row">
                    <div class="col-lg-7">
                        {{ form_label(form.title, 'Titre', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.title, {'attr': {'class': 'form-control', 'placeholder': 'Ex: Restez focus !'}}) }}
                    </div>
                    <div class="col-lg-5">
                        {{ form_label(form.mood, 'Humeur', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.mood, {'attr': {'class': 'form-select'}}) }}
                    </div>
                </div>

                <div style="margin-top: 24px;">
                    {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 5, 'placeholder': 'Partagez votre message inspirant...'}}) }}
                    <div class="nexa-form-help">Écrivez un message qui résonne avec votre état d'esprit actuel.</div>
                </div>

                <div style="margin-top: 24px;">
                    {{ form_label(form.image, 'URL de l\'image (optionnel)', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.image, {'attr': {'class': 'form-control', 'placeholder': 'https://images.unsplash.com/...'}}) }}
                    <div class="nexa-form-help">Optionnel : Ajoutez un visuel pour renforcer l'impact.</div>
                </div>
            </section>

            <div class="motivation-form-actions">
                <a href="{{ path('app_motivation_index') }}" class="goals-btn goals-btn-secondary">
                    Annuler
                </a>
                <button type="submit" class="goals-btn goals-btn-primary">
                    <i class="fa-solid fa-sparkles"></i> {{ motivation.id ? 'Mettre à jour' : 'Publier la motivation' }}
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}

