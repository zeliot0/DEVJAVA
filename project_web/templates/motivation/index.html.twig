{% extends 'base.html.twig' %}

{% set body_class = 'conscience-page' %}

{% block title %}Résonance Interne — NEXA Intelligence{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/conscience-modern-proo.css?v=' ~ 'now'|date('U')) }}">
    <style>
        .motivation-verse-card { background: white; border: 1px solid #efefef; border-radius: 16px; padding: 48px; position: relative; overflow: hidden; margin-bottom: 48px; }
        .arabic-text { font-family: "Amiri", serif; font-size: 36px; line-height: 1.8; text-align: center; color: #1a1a1a; margin-bottom: 32px; }
        .translation { font-size: 18px; line-height: 1.6; text-align: center; font-style: italic; color: var(--notion-text-muted); max-width: 800px; margin: 0 auto; }
        
        .mood-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 12px; margin-bottom: 48px; }
        .mood-btn { background: white; border: 1px solid #efefef; border-radius: 12px; padding: 16px; text-align: center; text-decoration: none; transition: all 0.2s; }
        .mood-btn:hover, .mood-btn.active { border-color: #3b82f6; background: #eff6ff; }
        .mood-emoji { font-size: 24px; display: block; margin-bottom: 8px; }
        .mood-name { font-size: 11px; font-weight: 700; color: var(--notion-text); text-transform: uppercase; }
        
        .m-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }
        .m-card { background: white; border: 1px solid #efefef; border-radius: 12px; padding: 24px; transition: all 0.2s; display: flex; flex-direction: column; }
        .m-card:hover { border-color: #3b82f6; transform: translateY(-3px); box-shadow: 0 10px 25px rgba(0,0,0,0.03); }
        .m-type { font-size: 9px; font-weight: 800; color: #3b82f6; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px; display: flex; align-items: center; gap: 6px; }

        .motivation-stats-wrap { margin-top: 48px; }
        .motivation-stats-title { font-size: 11px; font-weight: 700; color: var(--notion-text-muted); text-transform: uppercase; margin-bottom: 16px; }
        .motivation-stats-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; }
        .motivation-stat-card { background: white; border: 1px solid #efefef; border-radius: 12px; padding: 14px; display: flex; flex-direction: column; gap: 6px; }
        .motivation-stat-head { display: flex; align-items: center; gap: 8px; font-size: 11px; font-weight: 700; color: var(--notion-text-muted); text-transform: uppercase; }
        .motivation-stat-value { font-size: 26px; font-weight: 800; color: var(--notion-text); line-height: 1; }
        .motivation-stat-label { font-size: 11px; color: var(--notion-text-muted); }
    </style>
{% endblock %}

{% block body %}
<div class="conscience-modern-page">

    <header class="conscience-page-header">
        <h1>Centre de Résonance</h1>
        <p>Architectures d'inspiration et protocoles de renforcement psychologique.</p>
    </header>

    <div class="conscience-header-actions" style="margin-bottom: 40px;">
        <div class="page-actions">
            {% if not is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_motivation_new') }}" class="btn primary">
                    Nouvelle Inspiration
                </a>
            {% endif %}
        </div>
    </div>

    <!-- Quranic Inspiration Section -->
    {% if not is_granted('ROLE_ADMIN') and inspirational_message %}
    <section class="motivation-verse-card">
        <div style="position: absolute; top: 0; left: 0; width: 4px; height: 100%; background: #3b82f6;"></div>
        <div style="font-size: 11px; font-weight: 700; color: #3b82f6; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 32px; text-align: center;">
            <i class="fa-solid fa-moon" style="margin-right: 8px;"></i> VECTEUR DE SÉRÉNITÉ
        </div>
        
        <div class="arabic-text" dir="rtl">{{ inspirational_message.arabic }}</div>
        
        <div class="translation">" {{ inspirational_message.french }} "</div>
        
        <div style="margin-top: 32px; text-align: center; font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase;">
            {{ inspirational_message.source }}
        </div>
    </section>
    {% endif %}

    <!-- Mood Matrix -->
    {% if not is_granted('ROLE_ADMIN') %}
    <div class="section-title" style="margin-bottom: 24px; font-size: 11px; font-weight: 700; color: var(--notion-text-muted); text-transform: uppercase;">Matrice des États d'Esprit</div>
    <div class="mood-grid">
        {% set emoji_map = {
            'motivated': '🚀', 'happy': '😊', 'sad': '😢', 'stressed': '😵',
            'tired': '😴', 'determined': '😎', 'optimistic': '🌈'
        } %}
        
        <a href="{{ path('app_motivation_index') }}" class="mood-btn {{ not app.request.get('mood') ? 'active' : '' }}">
            <span class="mood-emoji">💠</span>
            <span class="mood-name">GLOBAL</span>
        </a>

        {% for mood in moods %}
            <a href="{{ path('app_motivation_by_mood', {'mood': mood}) }}" class="mood-btn {{ current_mood == mood ? 'active' : '' }}">
                <span class="mood-emoji">{{ emoji_map[mood]|default('🙂') }}</span>
                <span class="mood-name">{{ mood }}</span>
            </a>
        {% endfor %}
    </div>
    {% endif %}

    <!-- Motivation Assets -->
    <div class="section-title" style="margin-bottom: 24px; font-size: 11px; font-weight: 700; color: var(--notion-text-muted); text-transform: uppercase;">Dépôt d'Inspiration ({{ motivations|length }})</div>
    
    <div class="m-grid">
        {% for motivation in motivations %}
            <article class="m-card">
                <div class="m-type">
                    <span>{{ emoji_map[motivation.mood]|default('🙂') }}</span>
                    {{ motivation.mood }}
                </div>
                
                <h3 style="font-size: 16px; font-weight: 800; color: var(--notion-text); margin-bottom: 12px;">{{ motivation.title }}</h3>
                
                <p style="font-size: 14px; color: var(--notion-text-muted); line-height: 1.6; flex: 1; margin-bottom: 24px;">
                    {{ (motivation.description|striptags)|slice(0, 150) }}{{ motivation.description|striptags|length > 150 ? '...' : '' }}
                </p>
                
                <div style="display: flex; gap: 8px; border-top: 1px solid #f8fafc; padding-top: 16px;">
                    <a href="{{ path('app_motivation_show', {'id': motivation.id}) }}" class="btn" style="flex: 1; font-size: 11px; font-weight: 700; background: #f8fafc; border-color: #e2e8f0; color: var(--notion-text);">DÉTAILS</a>
                    {% if not is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_motivation_edit', {'id': motivation.id}) }}" class="btn" style="padding: 6px 10px; background: #f8fafc;"><i class="fa-solid fa-pen" style="font-size: 10px;"></i></a>
                    {% endif %}
                </div>
            </article>
        {% else %}
            <div style="grid-column: 1/-1; text-align: center; padding: 100px; background: white; border-radius: 12px; border: 1px dashed #efefef;">
                <div style="font-size: 48px; margin-bottom: 24px; opacity: 0.2;">✨</div>
                <h3 style="font-size: 16px; font-weight: 700; color: var(--notion-text-muted);">Rémanence Nulle</h3>
                <p style="font-size: 13px; color: var(--notion-text-muted); margin-bottom: 24px;">Aucun module d'inspiration n'a été configuré.</p>
                <a href="{{ path('app_motivation_new') }}" class="btn primary">Créer un actif d'inspiration</a>
            </div>
        {% endfor %}
    </div>

    <section class="motivation-stats-wrap">
        <h2 class="motivation-stats-title">Statistiques des motivations</h2>
        {% set mood_labels = {
            'motivated': 'Motivé',
            'happy': 'Heureux',
            'sad': 'Triste',
            'stressed': 'Stressé',
            'tired': 'Fatigué',
            'determined': 'Déterminé',
            'optimistic': 'Optimiste'
        } %}

        <div class="motivation-stats-grid">
            {% for mood in moods %}
                {% set mood_key = mood|lower %}
                {% set mood_count = mood_click_stats[mood_key]|default(0) %}
                <article class="motivation-stat-card">
                    <div class="motivation-stat-head">
                        <span class="mood-emoji">{{ emoji_map[mood_key]|default('🙂') }}</span>
                        <span>{{ mood_labels[mood_key]|default(mood|capitalize) }}</span>
                    </div>
                    <span class="motivation-stat-value">{{ mood_count }}</span>
                    <span class="motivation-stat-label">clic(s) humeur</span>
                </article>
            {% endfor %}
        </div>
    </section>

</div>
{% endblock %}
