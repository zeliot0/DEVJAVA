{% extends 'base.html.twig' %}

{% set body_class = 'conscience-page' %}

{% block title %}{{ message.titleMsg }} — NEXA Intelligence{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/time-message-modern.css?v=' ~ 'now'|date('U')) }}">
    <style>
        .tm-btn-danger { color: #ef4444; border-color: #fecaca; background: #fff1f2; }
        .tm-btn-danger:hover { background: #fef2f2; border-color: #ef4444; }
    </style>
{% endblock %}

{% block body %}
<div class="tm-page">
    {% for message in app.flashes('time_message_success') %}
        <div class="tm-form-note" style="margin-bottom: 18px; border-color: #bbf7d0; background: #f0fdf4; color: #166534;">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('time_message_error') %}
        <div class="tm-form-note" style="margin-bottom: 18px; border-color: #fecaca; background: #fef2f2; color: #991b1b;">
            {{ message }}
        </div>
    {% endfor %}

    <header class="tm-header">
        <div>
            <div style="font-size: 11px; font-weight: 800; color: #6366f1; text-transform: uppercase; letter-spacing: 0.2em; margin-bottom: 8px;">Analyse de Résonance</div>
            <h1 class="tm-title">
                {% if message.messageTypeG == 'future' %}
                    <i class="fas fa-rocket"></i> {{ message.titleMsg }}
                {% else %}
                    <i class="fas fa-history"></i> {{ message.titleMsg }}
                {% endif %}
            </h1>
            <p class="tm-subtitle">Instancié dans le continuum le {{ message.createdAtMsg|date('d F Y') }}</p>
        </div>
        <div class="tm-actions">
            <a href="{{ path('app_time_message_index') }}" class="tm-btn">
                <i class="fas fa-arrow-left"></i> Retour
            </a>
            {% if not is_granted('ROLE_ADMIN') %}
                <form method="post" action="{{ path('app_time_message_delete', {'id': message.idTimeMessage}) }}" onsubmit="return confirm('La suppression de ce message est irréversible dans le continuum. Confirmer ?');" style="display:inline-block;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ message.idTimeMessage) }}">
                    <button class="tm-btn tm-btn-danger" type="submit"><i class="fas fa-trash"></i> Dissoudre</button>
                </form>
            {% endif %}
        </div>
    </header>

    <div class="tm-show-container">
        <div class="tm-letter-stamp">
            <span>{{ message.messageTypeG == 'future' ? 'FUTURE' : 'PAST' }}</span>
            <span style="font-size: 8px; margin-top: 4px;">{{ message.createdAtMsg|date('Y-m-d') }}</span>
        </div>

        <div class="tm-letter-metadata" style="margin-bottom: 60px; display: flex; gap: 40px; border-bottom: 1px solid #f0f0f0; padding-bottom: 30px;">
            <div>
                <label class="tm-label">Origine</label>
                <div style="font-size: 15px; font-weight: 700; color: #1a1b23;">
                    {% if message.messageTypeG == 'future' %}
                        Projection du Futur
                    {% else %}
                        Echo du Passé
                    {% endif %}
                </div>
            </div>
            <div>
                <label class="tm-label">Point de Convergence</label>
                <div style="font-size: 15px; font-weight: 700; color: #4f46e5;">
                    {{ message.deliveryDateMsg ? message.deliveryDateMsg|date('d F Y') : message.createdAtMsg|date('d F Y') }}
                </div>
            </div>
            {% if goal %}
                <div>
                    <label class="tm-label">Objectif Lié</label>
                    <div style="font-size: 15px; font-weight: 700; color: #f59e0b;">{{ goal.titleGoa }}</div>
                </div>
            {% endif %}
        </div>

        <div class="tm-letter-body">
            {{ message.contentMsg|nl2br }}
        </div>

        {% if message.videoPathMsg %}
            <div style="margin-top: 60px; padding-top: 40px; border-top: 1px solid #f0f0f0;">
                <div class="tm-label" style="display: flex; align-items: center; gap: 8px; margin-bottom: 20px;">
                    <i class="fa-solid fa-video"></i> Fragment Holographique
                </div>
                <video controls style="width: 100%; border-radius: 16px; box-shadow: 0 20px 50px rgba(0,0,0,0.15); background: #000;">
                    <source src="{{ asset('uploads/videos/' ~ message.videoPathMsg) }}" type="video/mp4">
                    Système de lecture holographique non supporté.
                </video>
            </div>
        {% endif %}

        {% if aiResponse %}
            <div class="tm-ai-resonance">
                <i class="fas fa-robot"></i>
                <div class="tm-ai-title">Résonance Synthétique IA</div>
                <div class="tm-ai-text">
                    {{ aiResponse.contentMsg|nl2br }}
                </div>
                {% if not message.isDeliveredMsg %}
                    <div style="margin-top: 24px; padding: 12px 16px; background: rgba(79, 70, 229, 0.05); border-radius: 10px; font-size: 12px; color: #4f46e5; display: inline-flex; align-items: center; gap: 8px; font-weight: 600;">
                        <i class="fa-solid fa-lock"></i> Synchronisation complète prévue le {{ message.deliveryDateMsg|date('d F Y') }}
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </div>

    <div style="margin-top: 60px; padding: 32px; border-radius: 20px; background: white; border: 1px solid var(--notion-border); box-shadow: var(--card-shadow); display: flex; gap: 24px; align-items: center;">
        <div style="width: 48px; height: 48px; border-radius: 12px; background: #eff6ff; color: #3b82f6; display: flex; align-items: center; justify-content: center; font-size: 20px;">
            <i class="fa-solid fa-shield-halved"></i>
        </div>
        <div>
            <h4 style="font-size: 15px; font-weight: 800; color: #1a1b23; margin-bottom: 4px;">Protocole d'Intégrité Temporelle</h4>
            <p style="font-size: 13px; color: #6b7280; margin: 0; line-height: 1.5;">Ce fragment est crypté et protégé par la matrice NEXA Intelligence. Les résonances IA sont générées pour aligner vos perspectives temporelles.</p>
        </div>
    </div>

</div>
{% endblock %}
