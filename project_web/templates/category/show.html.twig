{% extends 'base.html.twig' %}

{% set body_class = 'conscience-page' %}

{% block title %}ANALYSE CATÉGORIE : {{ category.name }} — NEXA Intelligence{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/conscience-modern-proo.css?v=' ~ 'now'|date('U')) }}">
    <style>
        .cat-show-hero { background: white; border: 1px solid #efefef; border-radius: 12px; padding: 40px; margin-bottom: 32px; display: flex; align-items: center; gap: 32px; box-shadow: 0 10px 30px rgba(0,0,0,0.02); }
        .cat-hero-icon { width: 80px; height: 80px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-size: 32px; border: 1px solid rgba(0,0,0,0.05); }
        
        .prop-item { display: grid; grid-template-columns: 180px 1fr; padding: 16px 0; border-bottom: 1px solid #f8fafc; align-items: center; }
        .prop-item:last-child { border-bottom: none; }
        .prop-k { font-size: 11px; font-weight: 700; color: var(--notion-text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
        .prop-v { font-size: 14px; font-weight: 600; color: var(--notion-text); }
        
        .cat-action-box { display: flex; gap: 12px; margin-top: 40px; border-top: 1px solid #efefef; padding-top: 32px; justify-content: flex-end; }
    </style>
{% endblock %}

{% block body %}
<div class="conscience-modern-page">

    <header class="conscience-page-header">
        <h1>Analyse de Domaine : {{ category.name }}</h1>
        <p>Spécifications structurelles de la catégorie système ID #{{ category.id }}</p>
    </header>

    <div class="conscience-header-actions" style="margin-bottom: 32px;">
        <div class="page-actions">
            <a href="{{ path('app_category_index') }}" class="btn">
                ← Retour à la Taxonomie
            </a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn">
                    Éditer les Paramètres
                </a>
            {% endif %}
        </div>
    </div>

    <div class="cat-show-hero">
        <div class="cat-hero-icon" style="background: {{ category.color|default('#f1f1ef') }}; color: white;">
            <i class="{{ category.icon|default('fa-solid fa-folder-open') }}"></i>
        </div>
        <div style="flex: 1;">
            <h2 style="font-size: 28px; font-weight: 800; color: var(--notion-text); margin-bottom: 8px;">{{ category.name }}</h2>
            <p style="font-size: 15px; color: var(--notion-text-muted); max-width: 600px; line-height: 1.6;">{{ category.description ?: 'Aucune description détaillée n\'est associée à ce domaine de compétence.' }}</p>
        </div>
        <div style="text-align: right;">
            <div style="font-size: 10px; font-weight: 700; color: var(--notion-text-muted); text-transform: uppercase; margin-bottom: 4px;">STATUT OPÉRATIONNEL</div>
            <span class="detail-badge {{ category.isActive ? 'good' : 'neutral' }}" style="font-size: 11px; padding: 4px 12px;">
                {{ category.isActive ? 'ACTIF' : 'INACTIF' }}
            </span>
        </div>
    </div>

    <div style="background: white; border: 1px solid #efefef; border-radius: 12px; padding: 32px;">
        <div class="section-title" style="margin-bottom: 24px; font-size: 11px; font-weight: 700; color: #3b82f6; text-transform: uppercase;">Propriétés de Classification</div>
        
        <div class="prop-item">
            <div class="prop-k">Position Hiérarchique</div>
            <div class="prop-v">{{ category.position ?: '0' }}</div>
        </div>
        <div class="prop-item">
            <div class="prop-k">Visibilité</div>
            <div class="prop-v" style="text-transform: capitalize;">{{ category.visibility ?: 'Public' }}</div>
        </div>
        <div class="prop-item">
            <div class="prop-k">Limite de Tâches</div>
            <div class="prop-v">{{ category.taskLimit ?: 'Illimité (∞)' }}</div>
        </div>
        <div class="prop-item">
            <div class="prop-k">Date d'Instanciation</div>
            <div class="prop-v">{{ category.createAt ? category.createAt|date('d F Y à H:i') : 'Inconnue' }}</div>
        </div>
        {% if category.updateAt %}
            <div class="prop-item">
                <div class="prop-k">Dernière Pulsation</div>
                <div class="prop-v">{{ category.updateAt|date('d F Y à H:i') }}</div>
            </div>
        {% endif %}
        <div class="prop-item" style="border-bottom: none;">
            <div class="prop-k">Identifiant de Séquence (No)</div>
            <div class="prop-v">{{ category.no ?: 'N/A' }}</div>
        </div>
    </div>

    {% if is_granted('ROLE_ADMIN') %}
        <div class="cat-action-box">
             <form method="post" action="{{ path('app_category_delete', {'id': category.id}) }}" onsubmit="return confirm('La suppression d\'une catégorie peut affecter plusieurs vecteurs liés. Procéder ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
                <button type="submit" class="btn" style="background: #fef2f2; border-color: #fecaca; color: #ef4444; font-weight: 700; padding: 8px 16px;">
                    Démanteler la Catégorie
                </button>
            </form>
        </div>
    {% endif %}

</div>
{% endblock %}
