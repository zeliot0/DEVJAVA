{% extends 'base.html.twig' %}

{% set body_class = 'conscience-page' %}

{% block title %}Taxonomie des Catégories — NEXA Intelligence{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/conscience-modern-proo.css?v=' ~ 'now'|date('U')) }}">
    <style>
        .cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }
        .cat-card { background: white; border: 1px solid #efefef; border-radius: 12px; padding: 24px; transition: all 0.2s; position: relative; overflow: hidden; }
        .cat-card:hover { border-color: var(--notion-blue); transform: translateY(-2px); box-shadow: 0 10px 20px rgba(0,0,0,0.03); }
        .cat-icon-frame { width: 44px; height: 44px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 20px; margin-bottom: 20px; border: 1px solid rgba(0,0,0,0.05); }
        .cat-name { font-size: 16px; font-weight: 800; color: var(--notion-text); margin-bottom: 8px; display: flex; align-items: center; gap: 8px; }
        .cat-desc { font-size: 13px; color: var(--notion-text-muted); line-height: 1.5; margin-bottom: 20px; min-height: 3.2em; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
        .cat-meta { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f8fafc; padding-top: 16px; margin-top: auto; }
        .cat-status { font-size: 9px; font-weight: 800; padding: 3px 8px; border-radius: 4px; text-transform: uppercase; }
        .status-active { background: #dcfce7; color: #166534; }
        .status-inactive { background: #f1f1ef; color: #5f5e5b; }
        .cat-limit { font-size: 11px; font-weight: 700; color: var(--notion-text-muted); }
    </style>
{% endblock %}

{% block body %}
<div class="conscience-modern-page">

    <header class="conscience-page-header">
        <h1>Architecture des Catégories</h1>
        <p>Structuration systémique et classification des domaines opérationnels.</p>
    </header>

    <div class="conscience-header-actions" style="margin-bottom: 40px;">
        <div class="page-actions">
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_category_new') }}" class="btn primary">
                    Nouvelle Catégorie
                </a>
            {% endif %}
        </div>
    </div>

    <div class="cat-grid">
        {% for category in categories %}
            <article class="cat-card">
                <div class="cat-icon-frame" style="background: {{ category.color|default('#f1f1ef') }}; color: white;">
                    <i class="{{ category.icon|default('fa-solid fa-folder') }}"></i>
                </div>
                
                <h3 class="cat-name">
                    {{ category.name }}
                    <span class="cat-status {{ category.isActive ? 'status-active' : 'status-inactive' }}">
                        {{ category.isActive ? 'Actif' : 'Inactif' }}
                    </span>
                </h3>
                
                <p class="cat-desc">{{ category.description ?: 'Aucune définition structurelle pour cette catégorie.' }}</p>
                
                <div class="cat-meta">
                    <div class="cat-limit">
                        <i class="fa-solid fa-list-check" style="margin-right: 4px;"></i>
                        LIMITE: <strong>{{ category.taskLimit ?: '∞' }}</strong>
                    </div>
                    <div style="display: flex; gap: 8px;">
                        <a href="{{ path('app_category_show', {'id': category.id}) }}" class="btn" style="padding: 6px 10px; font-size: 11px; font-weight: 700;">DÉTAILS</a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn" style="padding: 6px 10px; font-size: 11px;"><i class="fa-solid fa-pen"></i></a>
                        {% endif %}
                    </div>
                </div>
            </article>
        {% else %}
            <div style="grid-column: 1/-1; text-align: center; padding: 100px; background: white; border-radius: 12px; border: 1px dashed #efefef;">
                <div style="font-size: 48px; margin-bottom: 24px; opacity: 0.2;">📂</div>
                <h3 style="font-size: 16px; font-weight: 700; color: var(--notion-text-muted);">Tabula Rasa</h3>
                <p style="font-size: 13px; color: var(--notion-text-muted); margin-bottom: 24px;">Aucune catégorie n'a été instanciée dans le système.</p>
                <a href="{{ path('app_category_new') }}" class="btn primary">Initialiser la première catégorie</a>
            </div>
        {% endfor %}
    </div>

</div>
{% endblock %}
