{% extends 'base.html.twig' %}

{% set body_class = 'conscience-page' %}

{% block title %}JALON : {{ milestone.title }} — NEXA Intelligence{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/conscience-modern-proo.css?v=' ~ 'now'|date('U')) }}">
    <style>
        .m-detail-card { background: white; border: 1px solid #efefef; border-radius: 12px; padding: 40px; box-shadow: 0 10px 30px rgba(0,0,0,0.02); }
        .m-property-chip { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: var(--notion-text); background: #f8fafc; padding: 8px 16px; border-radius: 20px; border: 1px solid #e2e8f0; }
    </style>
{% endblock %}

{% block body %}
<div class="conscience-modern-page">

    <header class="conscience-page-header">
        <h1>Analyse de Jalon : {{ milestone.title }}</h1>
        <p>Phase tactique du vecteur <strong>{{ milestone.goalGoa ? milestone.goalGoa.titleGoa : 'Non lié' }}</strong></p>
    </header>

    <div class="conscience-header-actions" style="margin-bottom: 32px;">
        <div class="page-actions">
            <a href="{{ path('app_milestones_index') }}" class="btn">
                ← Retour à la Séquence
            </a>
            {% if not is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_milestones_edit', {'id': milestone.id}) }}" class="btn">
                    Modifier le Jalon
                </a>
            {% endif %}
        </div>
    </div>

    <div class="m-detail-card">
        <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 32px;">
            <div class="m-property-chip">
                <i class="fa-solid fa-clock-rotate-left" style="color: #6366f1;"></i>
                Status: <span style="color: #6366f1;">{{ milestone.status|default('EN COURS')|upper }}</span>
            </div>
            <div class="m-property-chip">
                <i class="fa-solid fa-calendar-day" style="color: #3b82f6;"></i>
                Échéance: {{ milestone.dueDate ? milestone.dueDate|date('d F Y') : 'Indéfinie' }}
            </div>
            {% if milestone.goalGoa %}
                <div class="m-property-chip">
                    <i class="fa-solid fa-link" style="color: #8b5cf6;"></i>
                    Objectif: {{ milestone.goalGoa.titleGoa }}
                </div>
            {% endif %}
        </div>

        <div class="section-title" style="margin-bottom: 16px; font-size: 11px; font-weight: 700; color: var(--notion-text-muted); text-transform: uppercase;">Description de l'étape</div>
        <div style="font-size: 16px; line-height: 1.8; color: var(--notion-text); white-space: pre-wrap; margin-bottom: 48px;">
            {{ milestone.description ?: 'Aucune directive spécifiée pour ce jalon.' }}
        </div>

        {% if not is_granted('ROLE_ADMIN') %}
            <div style="margin-top: 40px; padding-top: 32px; border-top: 1px solid #efefef; text-align: right;">
                <form method="post" action="{{ path('app_milestones_delete', {'id': milestone.id}) }}" onsubmit="return confirm('Confirmer l\'effacement définitif de ce jalon ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ milestone.id) }}">
                    <button type="submit" class="btn" style="background: #fef2f2; border-color: #fecaca; color: #ef4444; font-weight: 700;">
                        Supprimer le jalon
                    </button>
                </form>
            </div>
        {% endif %}
    </div>

</div>
{% endblock %}
