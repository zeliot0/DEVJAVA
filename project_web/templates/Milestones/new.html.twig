{% extends 'base.html.twig' %}

{% set body_class = 'conscience-page' %}

{% block title %}NOUVEAU JALON — NEXA Intelligence{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/conscience-modern-proo.css?v=' ~ 'now'|date('U')) }}">
{% endblock %}

{% block body %}
<div class="conscience-modern-page">
    <header class="conscience-page-header">
        <h1>Architecture de Jalon</h1>
        <p>Instrumentation d'une nouvelle étape tactique pour le succès de la mission.</p>
    </header>

    <div class="conscience-header-actions" style="margin-bottom: 48px;">
        <div class="page-actions">
            <a href="{{ path('app_milestones_index') }}" class="btn">
                ← Retour à la Séquence
            </a>
        </div>
    </div>

    {{ include('milestones/_form.html.twig', {'button_label': 'Confirmer le Jalon'}) }}
</div>
{% endblock %}
