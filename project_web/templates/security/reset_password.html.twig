{% extends 'base.html.twig' %}
{% set body_class = 'auth-recovery-page' %}

{% block title %}Reinitialiser le mot de passe{% endblock %}
{% block sidebar %}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('css/auth-recovery.css?v=20260224a') }}">
  <style>
    body.auth-recovery-page .notion-header { display: none !important; }
    body.auth-recovery-page .notion-main { overflow: auto !important; }
    body.auth-recovery-page .notion-content {
      max-width: none !important;
      width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
      overflow: auto !important;
    }
  </style>
{% endblock %}

{% block body %}
<section class="recovery-page">
  <div class="recovery-card">
    <h1 class="recovery-title">Nouveau mot de passe</h1>
    <p class="recovery-subtitle">Choisissez un mot de passe fort pour securiser votre compte.</p>

    {% if error is defined %}
      <div class="recovery-alert">{{ error }}</div>
    {% endif %}

    <form method="post" class="recovery-form" id="reset-password-form" novalidate autocomplete="off" data-lpignore="true">
      <input type="text" name="fake_username" autocomplete="username" tabindex="-1" aria-hidden="true" style="display:none;">
      <input type="password" name="fake_password" autocomplete="new-password" tabindex="-1" aria-hidden="true" style="display:none;">

      <input
        type="password"
        id="reset-password"
        name="password"
        placeholder="Nouveau mot de passe"
        class="recovery-input"
        autocomplete="new-password"
        autocapitalize="off"
        spellcheck="false"
      >
      <input
        type="password"
        id="reset-confirm-password"
        name="confirm_password"
        placeholder="Confirmer le mot de passe"
        class="recovery-input"
        autocomplete="new-password"
        autocapitalize="off"
        spellcheck="false"
      >
      <div id="reset-client-error" class="recovery-alert" style="display:none;"></div>
      <div class="recovery-actions">
        <button type="submit" class="recovery-btn">Mettre a jour</button>
        <a href="{{ path('app_login') }}" class="recovery-link">Retour connexion</a>
      </div>
    </form>
  </div>
</section>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    (function () {
      const form = document.getElementById('reset-password-form');
      const pass = document.getElementById('reset-password');
      const confirmPass = document.getElementById('reset-confirm-password');
      const clientError = document.getElementById('reset-client-error');

      if (pass) pass.value = '';
      if (confirmPass) confirmPass.value = '';

      if (!form || !pass || !confirmPass || !clientError) return;

      form.addEventListener('submit', function (e) {
        clientError.style.display = 'none';
        clientError.textContent = '';

        if (pass.value.length < 8) {
          e.preventDefault();
          clientError.textContent = 'Le mot de passe doit contenir au moins 8 caracteres.';
          clientError.style.display = 'block';
          return;
        }

        if (pass.value !== confirmPass.value) {
          e.preventDefault();
          clientError.textContent = 'Les mots de passe ne correspondent pas.';
          clientError.style.display = 'block';
        }
      });
    })();
  </script>
{% endblock %}
