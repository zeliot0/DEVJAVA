{% extends 'base.html.twig' %}
{% set body_class = 'auth-recovery-page' %}

{% block title %}Mot de passe oublie{% endblock %}
{% block sidebar %}{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('css/auth-recovery.css?v=20260224a') }}">
  <style>
    body.auth-recovery-page .notion-header { display: none !important; }
    body.auth-recovery-page .notion-main { overflow: auto !important; }
    body.auth-recovery-page .notion-content {
      max-width: none !important;
      width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
      overflow: auto !important;
    }
  </style>
{% endblock %}

{% block body %}
<section class="recovery-page">
  <div class="recovery-card">
    <h1 class="recovery-title">Mot de passe oublie</h1>
    <p class="recovery-subtitle">Entrez votre email pour recevoir un lien de reinitialisation.</p>

    {% for message in app.flashes('error') %}
      <div class="recovery-alert">{{ message }}</div>
    {% endfor %}

    <form method="post" class="recovery-form" novalidate>
      <input type="email" name="email" placeholder="Votre email" class="recovery-input">
      <div class="g-recaptcha" data-sitekey="{{ recaptcha_site_key|default('') }}"></div>
      <div class="recovery-actions">
        <button type="submit" class="recovery-btn">Envoyer le lien</button>
        <a href="{{ path('app_login') }}" class="recovery-link">Retour connexion</a>
      </div>
    </form>
  </div>
</section>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="https://www.google.com/recaptcha/api.js" async defer></script>
{% endblock %}
