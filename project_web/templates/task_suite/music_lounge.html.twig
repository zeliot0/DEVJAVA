{% extends 'base.html.twig' %}

{% block title %}Music Lounge | Nexa{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/cyber-nexus.css?v=' ~ 'now'|date('U')) }}">
{% endblock %}

{% block body %}
<div class="music-lounge-container" data-suite-page="music">
    
    <!-- HEADER -->
    <header class="lounge-header">
        <div class="lounge-title">
            <h1>Music Lounge</h1>
            <p class="lounge-subtitle">Focus and flow with curated soundscapes.</p>
        </div>
        <a href="{{ path('app_task_suite_hub') }}" class="quit-btn">
            <i class="fa-solid fa-arrow-left"></i>
            Back to Workspace
        </a>
    </header>

    <div class="lounge-main">
        
        <!-- MAIN PLAYER -->
        <div class="player-card">
            <div id="cyberTrackCover" class="artwork-box" style="background-image: url('https://images.unsplash.com/photo-1470225620780-dba8ba36b745?q=80&w=800&auto=format&fit=crop');"></div>
            
            <div class="player-info">
                <h2 id="cyberTrackTitle" class="track-title">Ready to Listen</h2>
                <p id="cyberTrackArtist" class="track-artist">Select a track from the library</p>
                
                <div class="player-controls">
                    <button class="control-btn" id="cyberPrev"><i class="fa-solid fa-backward-step"></i></button>
                    <button class="play-pause-btn nexus-play-toggle" id="cyberPlayToggle">
                        <i class="fa-solid fa-play"></i>
                    </button>
                    <button class="control-btn" id="cyberNext"><i class="fa-solid fa-forward-step"></i></button>
                </div>
            </div>
        </div>

        <!-- SIDEBAR -->
        <div class="sidebar-panel">
            <div class="search-container">
                <input type="text" id="cyberSearch" class="search-input" placeholder="Search music (e.g. Ambient, Lo-fi)...">
            </div>
            
            <div class="track-list" id="cyberTrackList">
                <div style="padding: 20px; text-align: center; color: var(--nexa-text-muted);">
                    Loading library...
                </div>
            </div>
        </div>

    </div>

</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}
