{% extends 'base.html.twig' %}

{% block title %}NEXA Focus Ultra{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --focus-primary: #6366f1;
            --focus-secondary: #8b5cf6;
            --focus-bg: #030303;
            --focus-surface: rgba(255, 255, 255, 0.03);
            --focus-border: rgba(255, 255, 255, 0.08);
            --focus-text: #ffffff;
            --focus-text-muted: rgba(255, 255, 255, 0.5);
            --font-jakarta: 'Plus Jakarta Sans', sans-serif;
        }

        /* Reset immersive mode to 'Floating Pod' style */
        .focus-ultra {
            height: 820px;
            max-width: 1300px;
            margin: 40px auto;
            display: flex;
            position: relative;
            background: radial-gradient(circle at 50% 50%, #111 0%, #000 100%);
            color: #fff;
            font-family: var(--font-jakarta);
            border-radius: 32px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 40px 100px rgba(0,0,0,0.5);
        }

        .biome-bg {
            border-radius: 32px;
        }

        /* Ambient Backgrounds */
        .biome-bg {
            position: absolute;
            inset: 0;
            opacity: 0.5;
            transition: all 1s ease;
            z-index: 1;
            pointer-events: none;
        }

        .scene-space { background: radial-gradient(circle at 20% 30%, #1e1b4b 0%, transparent 60%), radial-gradient(circle at 80% 70%, #312e81 0%, transparent 60%); }
        .scene-forest { background: radial-gradient(circle at 20% 30%, #064e3b 0%, transparent 60%), radial-gradient(circle at 80% 70%, #065f46 0%, transparent 60%); }
        .scene-cyber { background: radial-gradient(circle at 20% 30%, #4c1d95 0%, transparent 60%), radial-gradient(circle at 80% 70%, #701a75 0%, transparent 60%); }

        /* Left Sidebar - Task Orbit */
        .focus-orbit {
            width: 300px;
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(30px);
            border-right: 1px solid var(--focus-border);
            z-index: 10;
            display: flex;
            flex-direction: column;
            padding: 40px 24px;
            transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .orbit-header h2 {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 3px;
            color: rgba(255,255,255,0.4);
            margin: 0 0 40px 0;
        }

        /* Center Stage */
        .focus-stage {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            z-index: 5;
            padding-bottom: 80px; /* Spacer for bottom dock */
        }

        .timer-portal {
            position: relative;
            width: 420px;
            height: 420px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 40px;
        }

        .portal-ring {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,0.05);
            z-index: 1;
        }

        .portal-progress {
            position: absolute;
            inset: 0;
            z-index: 2;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .portal-progress svg {
            width: 100%;
            height: 100%;
            transform: rotate(-90deg);
        }

        .portal-progress circle {
            fill: none;
            stroke: var(--focus-primary);
            stroke-width: 3;
            stroke-linecap: round;
            transition: stroke-dashoffset 1s linear;
            filter: drop-shadow(0 0 12px var(--focus-primary));
        }

        .timer-content {
            position: relative;
            z-index: 10;
            text-align: center;
            width: 80%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        #timerDisplay {
            font-size: 100px;
            font-weight: 800;
            letter-spacing: -4px;
            line-height: 0.9;
            margin: 0;
            font-variant-numeric: tabular-nums;
        }

        .timer-status {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 4px;
            color: rgba(255,255,255,0.4);
            margin-top: 15px;
            max-width: 100%;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        /* Controls Area */
        .focus-controls {
            display: flex;
            gap: 32px;
            align-items: center;
            justify-content: center;
            z-index: 100;
            position: relative;
        }

        .btn-core {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            color: #fff;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            outline: none;
        }

        .btn-core:hover {
            background: rgba(255,255,255,0.15);
            border-color: rgba(255,255,255,0.3);
            transform: translateY(-4px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.4);
        }

        .btn-core.primary {
            width: 80px;
            height: 80px;
            background: #fff;
            color: #000;
            font-size: 24px;
            border: none;
            box-shadow: 0 0 40px rgba(255,255,255,0.2);
        }

        .btn-core.primary:hover {
            background: #f0f0f0;
            transform: translateY(-4px) scale(1.05);
            box-shadow: 0 15px 30px rgba(255,255,255,0.3);
        }

        .task-stack {
            flex: 1;
            overflow-y: auto;
            scrollbar-width: none;
        }
        .task-stack::-webkit-scrollbar { display: none; }

        .orb-task {
            padding: 20px;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 16px;
            margin-bottom: 12px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .orb-task:hover {
            background: rgba(255,255,255,0.08);
            transform: translateX(5px);
        }

        .orb-task.active {
            background: rgba(255,255,255,0.1);
            border-color: var(--focus-primary);
        }

        .orb-task h4 { margin: 0 0 5px 0; font-size: 14px; font-weight: 600; }
        .orb-task p { margin: 0; font-size: 11px; color: rgba(255,255,255,0.4); }

        .dock-sep {
            width: 1px;
            height: 16px;
            background: rgba(255,255,255,0.1);
        }

        /* Refined Dock */
        .focus-dock {
            position: absolute;
            bottom: 32px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(10, 10, 10, 0.85);
            -webkit-backdrop-filter: blur(24px);
            backdrop-filter: blur(24px);
            padding: 12px 32px;
            border-radius: 100px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            gap: 32px;
            align-items: center;
            z-index: 200;
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
        }

        .dock-item {
            color: rgba(255, 255, 255, 0.4);
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: all 0.2s ease;
            white-space: nowrap;
            letter-spacing: 0.02em;
        }

        .dock-item i {
            font-size: 14px;
        }

        .dock-item:hover, .dock-item.active {
            color: #fff;
            transform: translateY(-1px);
        }

        .dock-item.active {
            color: var(--focus-primary);
        }

        /* Exit button - more subtle */
        .focus-exit {
            position: absolute;
            top: 40px;
            right: 40px;
            z-index: 1000;
        }

        .btn-exit {
            color: rgba(255,255,255,0.3);
            text-decoration: none;
            font-size: 12px;
            letter-spacing: 2px;
            text-transform: uppercase;
            transition: color 0.2s;
        }

        .btn-exit:hover {
            color: #ff4b4b;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="focus-ultra" id="focusRoot">
        <div class="biome-bg scene-space" id="biomeBg"></div>

        <div class="focus-exit">
            {% if app.request.query.get('embed') == '1' %}
                <a href="#" class="btn-exit" onclick="window.parent.postMessage({type: 'nexa-focus-inline-close'}, '*')">
                   QUITTER <i class="fa-solid fa-xmark"></i>
                </a>
            {% else %}
                <a href="{{ path('app_task_index') }}" class="btn-exit">
                   RETOUR <i class="fa-solid fa-arrow-left"></i>
                </a>
            {% endif %}
        </div>

        <!-- Left: Task Orbit -->
        <aside class="focus-orbit">
            <div class="orbit-header">
                <h2>Votre Mission</h2>
            </div>
            <div class="task-stack" id="focusTaskList">
                {% for task in tasks %}
                    <div class="orb-task {{ loop.first ? 'active' : '' }}" data-id="{{ task.id }}" data-title="{{ task.title }}">
                        <h4>{{ task.title }}</h4>
                        <p>{{ task.category ? task.category.name : 'No category' }}</p>
                    </div>
                {% endfor %}
            </div>
        </aside>

        <!-- Main Stage -->
        <section class="focus-stage">
            <div class="timer-portal" id="timerPortal">
                <div class="portal-ring"></div>
                <div class="portal-progress">
                    <svg viewBox="0 0 420 420">
                        <circle id="timerCircle" cx="210" cy="210" r="208" 
                                stroke-dasharray="1306" stroke-dashoffset="0"></circle>
                    </svg>
                </div>
                <div class="timer-content">
                    <div id="timerDisplay">25:00</div>
                    <div class="timer-status" id="timerStatus">FOCUS TIME</div>
                </div>
            </div>

            <div class="focus-controls">
                <button class="btn-core" id="btnReset"><i class="fa-solid fa-rotate-right"></i></button>
                <button class="btn-core primary" id="btnPlayPause"><i class="fa-solid fa-play"></i></button>
                <button class="btn-core" id="btnSkip"><i class="fa-solid fa-forward"></i></button>
            </div>
        </section>

        <!-- Dock -->
        <div class="focus-dock">
            <div class="dock-item active" data-scene="space"><i class="fa-solid fa-user-astronaut"></i> <span>Espace</span></div>
            <div class="dock-item" data-scene="forest"><i class="fa-solid fa-tree"></i> <span>Forêt</span></div>
            <div class="dock-item" data-scene="cyber"><i class="fa-solid fa-microchip"></i> <span>Cyber</span></div>
            <div class="dock-sep"></div>
            <div class="dock-item" id="btnSoundToggle"><i class="fa-solid fa-volume-high"></i> <span>Audio</span></div>
            <div class="dock-item" id="btnFaceGuard"><i class="fa-solid fa-eye-slash"></i> <span>Face Guard</span></div>
            <div class="dock-sep"></div>
            <div class="dock-item" id="btnZen"><i class="fa-solid fa-expand"></i> <span>Focus Pro</span></div>
        </div>

        <audio id="focusAudio" loop>
            <source src="https://www.soundhelix.com/examples/mp3/SoundHelix-Song-8.mp3" type="audio/mpeg">
        </audio>

        <video id="faceVideo" style="display:none;" autoplay muted playsinline></video>
    </div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', () => {
    const timerDisplay = document.getElementById('timerDisplay');
    const timerCircle = document.getElementById('timerCircle');
    const timerPortal = document.getElementById('timerPortal');
    const btnPlayPause = document.getElementById('btnPlayPause');
    const btnReset = document.getElementById('btnReset');
    const btnSkip = document.getElementById('btnSkip');
    const biomeBg = document.getElementById('biomeBg');
    const audio = document.getElementById('focusAudio');
    const soundToggle = document.getElementById('btnSoundToggle');
    const zenBtn = document.getElementById('btnZen');
    const faceBtn = document.getElementById('btnFaceGuard');
    const faceVideo = document.getElementById('faceVideo');
    const taskItems = document.querySelectorAll('.orb-task');

    let timeLeft = 25 * 60;
    let totalTime = 25 * 60;
    let timerId = null;
    let isRunning = false;
    let phase = 'focus'; 
    let faceGuardActive = false;
    let stream = null;

    const updateUI = () => {
        const mins = Math.floor(timeLeft / 60);
        const secs = timeLeft % 60;
        timerDisplay.textContent = `${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
        
        const circumference = 1306;
        const offset = circumference - (timeLeft / totalTime) * circumference;
        timerCircle.style.strokeDashoffset = isNaN(offset) ? 0 : offset;
    };

    const toggleTimer = () => {
        if (isRunning) {
            clearInterval(timerId);
            btnPlayPause.innerHTML = '<i class="fa-solid fa-play"></i>';
            timerPortal.classList.remove('active');
        } else {
            timerId = setInterval(() => {
                if (timeLeft > 0) {
                    timeLeft--;
                    updateUI();
                } else {
                    switchPhase();
                }
            }, 1000);
            btnPlayPause.innerHTML = '<i class="fa-solid fa-pause"></i>';
            timerPortal.classList.add('active');
        }
        isRunning = !isRunning;
    };

    const switchPhase = () => {
        clearInterval(timerId);
        isRunning = false;
        if (phase === 'focus') {
            phase = 'break';
            timeLeft = 5 * 60;
            totalTime = 5 * 60;
            document.getElementById('timerStatus').textContent = 'TIME FOR BREAK';
            document.documentElement.style.setProperty('--focus-primary', '#10b981');
        } else {
            phase = 'focus';
            timeLeft = 25 * 60;
            totalTime = 25 * 60;
            document.getElementById('timerStatus').textContent = 'BACK TO FOCUS';
            document.documentElement.style.setProperty('--focus-primary', '#6366f1');
        }
        updateUI();
        btnPlayPause.innerHTML = '<i class="fa-solid fa-play"></i>';
    };

    btnPlayPause.onclick = toggleTimer;
    btnReset.onclick = () => {
        clearInterval(timerId);
        isRunning = false;
        timeLeft = (phase === 'focus' ? 25 : 5) * 60;
        updateUI();
        btnPlayPause.innerHTML = '<i class="fa-solid fa-play"></i>';
    };
    btnSkip.onclick = switchPhase;

    // Biomes
    document.querySelectorAll('[data-scene]').forEach(item => {
        item.onclick = () => {
            document.querySelectorAll('[data-scene]').forEach(i => i.classList.remove('active'));
            item.classList.add('active');
            biomeBg.className = `biome-bg scene-${item.dataset.scene}`;
        };
    });

    soundToggle.onclick = () => {
        if (audio.paused) {
            audio.play();
            soundToggle.innerHTML = '<i class="fa-solid fa-volume-high"></i> <span>Audio</span>';
        } else {
            audio.pause();
            soundToggle.innerHTML = '<i class="fa-solid fa-volume-xmark"></i> <span>Audio</span>';
        }
    };

    faceBtn.onclick = async () => {
        if (!faceGuardActive) {
            try {
                stream = await navigator.mediaDevices.getUserMedia({ video: true });
                faceVideo.srcObject = stream;
                faceGuardActive = true;
                faceBtn.innerHTML = '<i class="fa-solid fa-eye" style="color:#6366f1"></i> <span>Face On</span>';
                faceBtn.classList.add('active');
            } catch (e) {
                alert("Camera access required for Face Guard");
            }
        } else {
            if (stream) stream.getTracks().forEach(t => t.stop());
            faceGuardActive = false;
            faceBtn.innerHTML = '<i class="fa-solid fa-eye-slash"></i> <span>Face Guard</span>';
            faceBtn.classList.remove('active');
        }
    };

    zenBtn.onclick = () => {
        const orbit = document.querySelector('.focus-orbit');
        const isHidden = orbit.style.display === 'none';
        orbit.style.display = isHidden ? 'flex' : 'none';
        zenBtn.classList.toggle('active');
        zenBtn.querySelector('span').textContent = isHidden ? 'Focus Pro' : 'Zen View';
    };

    taskItems.forEach(task => {
        task.onclick = () => {
            taskItems.forEach(t => t.classList.remove('active'));
            task.classList.add('active');
            document.getElementById('timerStatus').textContent = task.dataset.title;
        };
    });

    updateUI();
});
</script>
{% endblock %}
