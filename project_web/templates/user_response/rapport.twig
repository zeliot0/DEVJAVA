{% extends 'base.html.twig' %}

{% set body_class = 'conscience-page' %}

{% block title %}AUDIT SYSTÉMIQUE — {{ theme.nom }} — NEXA Intelligence{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/conscience-modern-proo.css?v=' ~ 'now'|date('U')) }}">
    <style>
        .report-card-premium {
            background: white; border: 1px solid var(--notion-border); border-radius: 24px; padding: 40px; box-shadow: var(--card-shadow); margin-bottom: 40px;
        }
        .metric-cell { padding: 20px; border-radius: 16px; background: #f9fafb; border: 1px solid #f3f4f6; }
        .metric-value { font-size: 24px; font-weight: 800; color: #1a1b23; font-family: 'Space Grotesk', sans-serif; }
        .metric-label { font-size: 10px; font-weight: 800; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 4px; }
        
        .action-node { 
            padding: 24px; border-radius: 20px; border: 1px solid #f3f4f6; background: white; 
            margin-bottom: 16px; display: flex; gap: 20px; align-items: flex-start; transition: all 0.3s;
        }
        .action-node:hover { transform: translateX(8px); border-color: #e5e7eb; box-shadow: 0 10px 20px -5px rgba(0,0,0,0.05); }
        .node-icon { 
            width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0;
        }

        .convergence-row {
            display: grid; grid-template-columns: 1fr auto auto auto; gap: 24px; align-items: center; padding: 24px;
            background: white; border-radius: 20px; border: 1px solid #f3f4f6; margin-bottom: 12px; transition: all 0.3s;
        }
        .convergence-row:hover { background: #f9fafb; border-color: var(--nexa-indigo); }
        .status-badge { padding: 4px 12px; border-radius: 100px; font-size: 11px; font-weight: 800; text-transform: uppercase; }
        .status-badge.optimal { background: #dcfce7; color: #166534; }
        .status-badge.risk { background: #fef2f2; color: #ef4444; }
        .status-badge.stby { background: #f3f4f6; color: #6b7280; }
    </style>
{% endblock %}

{% block body %}
<div class="conscience-modern-page">

    <header class="conscience-page-header">
        <div>
            <div style="font-size: 11px; font-weight: 800; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.2em; margin-bottom: 8px;">Intelligence Prédictive</div>
            <h1 style="font-family: 'Space Grotesk', sans-serif;">Audit : {{ theme.nom }}</h1>
            <p>Rapport de résonance systémique et plan de mutation opérationnelle.</p>
        </div>
        <div style="display: flex; gap: 12px; margin-top: 24px;">
            <a href="{{ path('app_theme_answer', { id: theme.idT }) }}" class="btn">
                <i class="fas fa-play"></i> Nouvelle Capture
            </a>
            <a href="{{ path('app_conscience_index') }}" class="btn">
                <i class="fas fa-arrow-left"></i> Hub
            </a>
            <a href="{{ path('app_theme_rapport_pdf', { id: theme.idT }) }}" class="btn primary">
                <i class="fas fa-file-pdf"></i> Exporter l'Audit
            </a>
        </div>
    </header>

    {% if details is empty %}
        <div style="text-align: center; padding: 100px; background: white; border-radius: 32px; border: 2px dashed #e5e7eb;">
            <i class="fa-solid fa-chart-pie" style="font-size: 64px; color: #d1d5db; margin-bottom: 32px;"></i>
            <h3 style="font-size: 22px; font-weight: 800; color: #1a1b23;">Matrice d'Analyse Vide</h3>
            <p style="color: #9ca3af; max-width: 450px; margin: 16px auto 32px; line-height: 1.6;">Le système requiert une série de captures de données pour générer des insights prédictifs fiables.</p>
            <a href="{{ path('app_theme_answer', { id: theme.idT }) }}" class="btn primary" style="padding: 14px 40px; font-weight: 800;">LANCER L'INTÉGRATION</a>
        </div>
    {% else %}

        <div class="section-title" style="margin-bottom: 24px; font-size: 11px; font-weight: 800; color: var(--nexa-indigo); text-transform: uppercase; letter-spacing: 0.2em;">INDICES DE RÉSONANCE GLOBAL</div>
        
        <div class="report-card-premium" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px;">
            <div class="metric-cell">
                <div class="metric-label">Score de Qualité</div>
                <div class="metric-value">{{ insights.weightedScore|default(0) }}%</div>
                <div style="margin-top: 8px; height: 4px; background: #e5e7eb; border-radius: 2px; overflow: hidden;">
                    <div style="width: {{ insights.weightedScore|default(0) }}%; height: 100%; background: #6366f1;"></div>
                </div>
            </div>
            <div class="metric-cell" style="background: #fdf2f2; border-color: #fee2e2;">
                <div class="metric-label" style="color: #ef4444;">Index de Risque</div>
                <div class="metric-value" style="color: #ef4444;">{{ insights.riskIndex|default(0) }}%</div>
                <div style="margin-top: 8px; height: 4px; background: #fee2e2; border-radius: 2px; overflow: hidden;">
                    <div style="width: {{ insights.riskIndex|default(0) }}%; height: 100%; background: #ef4444;"></div>
                </div>
            </div>
            <div class="metric-cell">
                <div class="metric-label">Fiabilité Capteurs</div>
                <div class="metric-value">{{ insights.completionRate|default(0) }}%</div>
                <div style="font-size: 11px; color: #6b7280; font-weight: 700; margin-top: 4px;">COUVERTURE</div>
            </div>
            <div class="metric-cell" style="background: #ecfdf5; border-color: #d1fae5;">
                <div class="metric-label" style="color: #059669;">Niveau de Maturité</div>
                <div class="metric-value" style="color: #059669; font-size: 18px; padding-top: 6px;">{{ insights.maturityLevel|default('Analyse...') }}</div>
            </div>
        </div>

        <div style="background: #1a1b23; border-radius: 24px; padding: 40px; margin-bottom: 60px; display: flex; align-items: center; gap: 40px; color: white; box-shadow: 0 20px 40px rgba(0,0,0,0.15);">
            <div style="width: 80px; height: 80px; border-radius: 20px; background: rgba(255,255,255,0.1); display: flex; align-items: center; justify-content: center; font-size: 40px; flex-shrink: 0;">🧠</div>
            <div>
                <h4 style="font-size: 12px; font-weight: 800; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px;">SYNTHÈSE SYSTÉMIQUE</h4>
                <p style="font-size: 18px; color: white; line-height: 1.6; font-weight: 500; margin: 0;">{{ insights.summary|default('Analyse des vecteurs de tendance en cours...') }}</p>
            </div>
        </div>

        <div class="section-title" style="margin-bottom: 24px; font-size: 11px; font-weight: 800; color: #10b981; text-transform: uppercase; letter-spacing: 0.2em;">PLAN DE MUTATION OPÉRATIONNELLE</div>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 24px; margin-bottom: 60px;">
            <div class="action-column">
                <label style="display: block; font-size: 10px; font-weight: 800; color: #ef4444; margin-bottom: 16px;">VIGILANCE IMMÉDIATE</label>
                {% for item in insights.actionPlan.immediate|default([]) %}
                    <div class="action-node" style="border-left: 4px solid #ef4444;">
                        <div class="node-icon" style="background: #fef2f2; color: #ef4444;"><i class="fas fa-exclamation-triangle"></i></div>
                        <div>
                            <div style="font-size: 14px; font-weight: 700; color: #1a1b23; margin-bottom: 4px;">{{ item.title }}</div>
                            <p style="font-size: 13px; color: #6b7280; margin: 0; line-height: 1.5;">{{ item.action }}</p>
                        </div>
                    </div>
                {% else %}
                    <div style="padding: 24px; border-radius: 20px; background: #f9fafb; text-align: center; color: #9ca3af; font-size: 13px;">Aucun risque critique.</div>
                {% endfor %}
            </div>

            <div class="action-column">
                <label style="display: block; font-size: 10px; font-weight: 800; color: #6366f1; margin-bottom: 16px;">COURT TERME (W7)</label>
                {% for item in insights.actionPlan.weekly|default([]) %}
                    <div class="action-node" style="border-left: 4px solid #6366f1;">
                        <div class="node-icon" style="background: #eef2ff; color: #6366f1;"><i class="fas fa-calendar-check"></i></div>
                        <div>
                            <div style="font-size: 14px; font-weight: 700; color: #1a1b23; margin-bottom: 4px;">{{ item.title }}</div>
                            <p style="font-size: 13px; color: #6b7280; margin: 0; line-height: 1.5;">{{ item.action }}</p>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="action-column">
                <label style="display: block; font-size: 10px; font-weight: 800; color: #059669; margin-bottom: 16px;">MUTATION STRATÉGIQUE</label>
                {% for item in insights.actionPlan.strategic|default([]) %}
                    <div class="action-node" style="border-left: 4px solid #059669;">
                        <div class="node-icon" style="background: #ecfdf5; color: #059669;"><i class="fas fa-chess"></i></div>
                        <div>
                            <div style="font-size: 14px; font-weight: 700; color: #1a1b23; margin-bottom: 4px;">{{ item.title }}</div>
                            <p style="font-size: 13px; color: #6b7280; margin: 0; line-height: 1.5;">{{ item.action }}</p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        <div class="section-title" style="margin-bottom: 24px; font-size: 11px; font-weight: 800; color: #f59e0b; text-transform: uppercase; letter-spacing: 0.2em;">CONVERGENCE DES INDICATEURS</div>

        <div style="margin-bottom: 80px;">
            {% for item in details %}
                <div class="convergence-row">
                    <div>
                        <div style="font-size: 15px; font-weight: 700; color: #1a1b23; margin-bottom: 4px;">{{ item.question }}</div>
                        <div style="font-size: 11px; color: #9ca3af; font-weight: 600;">DATE LOG : {{ item.date|date('d F Y') }}</div>
                    </div>
                    
                    <div style="text-align: center; min-width: 150px;">
                        <span class="status-badge {{ item.ok is same as(true) ? 'optimal' : (item.ok is same as(false) ? 'risk' : 'stby') }}">
                            {{ item.ok is same as(true) ? 'OPTIMAL' : (item.ok is same as(false) ? 'RISQUE' : 'NEUTRE') }}
                        </span>
                    </div>

                    <div style="text-align: right; min-width: 120px;">
                        <div style="font-size: 20px; font-weight: 800; color: #1a1b23;">
                            {% if item.type == 'boolean' %}
                                {{ item.value == '1' ? 'YES' : 'NO' }}
                            {% else %}
                                {{ item.value }}{% if item.unite %} {{ item.unite }}{% endif %}
                            {% endif %}
                        </div>
                    </div>

                    <div style="min-width: 140px; text-align: right;">
                        {% if item.type == 'number' and item.ideal is not null %}
                            <div style="font-size: 10px; font-weight: 800; color: #3b82f6; text-transform: uppercase;">CIBLE : {{ item.ideal }}</div>
                            <div style="font-size: 11px; color: {{ item.gap >= 0 ? '#059669' : '#ef4444' }}; font-weight: 700;">
                                GAP : {{ item.gap|number_format(1) }} ({{ item.gapPercent|number_format(1) }}%)
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
        <div class="section-title" style="margin-bottom: 24px; font-size: 11px; font-weight: 800; color: #6366f1; text-transform: uppercase; letter-spacing: 0.2em;">TACHES SUGGEREES PAR THEME</div>

        {% if taskSuggestions is empty %}
            <div style="margin-bottom: 32px; background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 16px; padding: 18px; color: #64748b; font-size: 13px;">
                Aucune tache critique detectee. Les suggestions preventives apparaissent ici automatiquement.
            </div>
        {% else %}
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 32px;">
                {% for suggestion in taskSuggestions %}
                    <article style="background: white; border: 1px solid #e5e7eb; border-radius: 20px; padding: 20px;">
                        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; margin-bottom: 10px;">
                            <h4 style="font-size: 15px; font-weight: 800; color: #111827; margin: 0;">{{ suggestion.title }}</h4>
                            <span class="status-badge {{ suggestion.priority == 'high' ? 'risk' : (suggestion.priority == 'low' ? 'stby' : 'optimal') }}">
                                {{ suggestion.priority|upper }}
                            </span>
                        </div>
                        <p style="margin: 0 0 10px 0; color: #4b5563; font-size: 13px; line-height: 1.5;">{{ suggestion.description }}</p>
                        <p style="margin: 0 0 14px 0; color: #6b7280; font-size: 12px; line-height: 1.5;">
                            <strong>Preuve:</strong> {{ suggestion.evidence }}
                        </p>
                        <div style="display: flex; align-items: center; justify-content: space-between; gap: 10px;">
                            <span style="font-size: 11px; color: #6b7280; font-weight: 700;">Echeance: {{ suggestion.dueAt|date('d/m/Y') }}</span>
                            <button type="button" class="btn primary report-add-task-btn" data-suggestion-id="{{ suggestion.id }}" style="padding: 8px 14px; font-size: 12px; font-weight: 800;">
                                Ajouter a mes taches
                            </button>
                        </div>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    {% endif %}

</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if taskSuggestions is not empty %}
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const acceptUrl = "{{ path('app_theme_task_suggestion_accept', { id: theme.idT }) }}";
                const buttons = document.querySelectorAll('.report-add-task-btn');

                buttons.forEach((btn) => {
                    btn.addEventListener('click', async () => {
                        const suggestionId = btn.getAttribute('data-suggestion-id');
                        if (!suggestionId) {
                            return;
                        }

                        const initialText = btn.textContent;
                        btn.disabled = true;
                        btn.textContent = 'Ajout...';

                        try {
                            const response = await fetch(acceptUrl, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ suggestionId })
                            });
                            const payload = await response.json();

                            if (!response.ok || !payload || payload.ok !== true) {
                                throw new Error('task_create_failed');
                            }

                            btn.textContent = payload.created ? 'Ajoute' : 'Deja existante';
                            btn.classList.remove('primary');
                        } catch (error) {
                            btn.disabled = false;
                            btn.textContent = initialText || 'Ajouter a mes taches';
                        }
                    });
                });
            });
        </script>
    {% endif %}
{% endblock %}

