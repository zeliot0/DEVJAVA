<!DOCTYPE html>
<html lang="fr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NEXA - L'Écosystème Intelligent</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/TextPlugin.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>
    <style>
        :root {
            --primary: #3b82f6;
            --dark: #0a0a0a;
        }
        
        body {
            font-family: 'Space Grotesk', sans-serif;
            background-color: var(--dark);
            color: white;
            overflow-x: hidden;
        }

        /* Grille de fond animée */
        .grid-bg {
            background-image: 
                linear-gradient(to right, rgba(255,255,255,0.03) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255,255,255,0.03) 1px, transparent 1px);
            background-size: 60px 60px;
            mask-image: radial-gradient(circle at center, black, transparent 90%);
        }

        .cursor-glow {
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.1) 0%, transparent 70%);
            position: fixed;
            pointer-events: none;
            z-index: 0;
            transform: translate(-50%, -50%);
        }

        .reveal-text {
            clip-path: polygon(0 0, 100% 0, 100% 100%, 0% 100%);
        }

        .horizontal-container {
            width: 400%;
            display: flex;
            flex-wrap: nowrap;
        }

        .horizontal-panel {
            width: 100vw;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 10%;
        }

        .stack-card {
            position: sticky;
            top: 15vh;
            transition: transform 0.1s ease-out;
        }

        /* Effet Terminal */
        .terminal-window {
            background: #121212;
            border: 1px solid rgba(255,255,255,0.1);
            box-shadow: 0 30px 60px rgba(0,0,0,0.5);
        }

        .typing-cursor {
            display: inline-block;
            width: 8px;
            height: 18px;
            background: var(--primary);
            margin-left: 4px;
            animation: blink 1s infinite;
        }

        @keyframes blink { 50% { opacity: 0; } }

        .btn-tech {
            position: relative;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,0.1);
            transition: all 0.3s ease;
        }
        
        .btn-tech::before {
            content: '';
            position: absolute;
            top: 0; left: -100%;
            width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
            transition: 0.5s;
        }
        .btn-tech:hover::before { left: 100%; }

        .marquee-line {
            display: flex;
            gap: 4rem;
            white-space: nowrap;
        }
    </style>
</head>
<body>

    <div class="cursor-glow" id="glow"></div>
    <div class="fixed inset-0 grid-bg pointer-events-none"></div>

    <!-- Navigation -->
    <nav class="fixed top-0 w-full z-50 px-6 md:px-12 py-8 flex justify-between items-center mix-blend-difference">
        <div class="flex items-center gap-3">
            <a href="{{ path('app_public_home') }}" class="flex items-center gap-3 no-underline text-inherit">
                <div class="w-10 h-10 bg-white rounded flex items-center justify-center">
                    <span class="text-black font-black text-2xl">N</span>
                </div>
                <span class="text-2xl font-bold tracking-tighter uppercase">NEXA</span>
            </a>
        </div>
        <div class="hidden md:flex gap-12 text-[10px] font-bold uppercase tracking-[0.2em] opacity-60">
            <a href="#stats" class="hover:opacity-100 transition-opacity">Métriques</a>
            <a href="#architecture" class="hover:opacity-100 transition-opacity">Architecture</a>
            <a href="#horizontal" class="hover:opacity-100 transition-opacity">Interface</a>
        </div>
        <a href="{{ path('app_landing') }}" class="btn-tech bg-blue-600 text-white px-8 py-3 rounded-full font-bold text-[10px] uppercase tracking-widest shadow-lg shadow-blue-600/20 no-underline">Initialiser le Flux</a>
    </nav>

    <!-- Section Hero -->
    <section class="h-screen flex flex-col justify-center items-center px-6 relative">
        <div class="absolute top-1/4 left-10 opacity-5 text-[25vh] font-black pointer-events-none select-none">AI_CORE</div>
        
        <div class="text-center z-10">
            <div class="inline-block px-4 py-1 border border-blue-500/30 rounded-full text-blue-400 text-[10px] font-bold tracking-widest uppercase mb-8 opacity-0" id="hero-tag">V3.0 Operationnelle</div>
            <h1 class="text-6xl md:text-[9rem] font-black leading-[0.85] mb-8 reveal-text tracking-tighter" id="main-title">
                ARCHITECTURE <br> <span class="text-blue-500">INFINIE.</span>
            </h1>
            <p class="text-slate-400 text-lg md:text-xl max-w-2xl mx-auto mb-12 opacity-0" id="hero-sub">
                Déployez vos ambitions sur une plateforme cognitive qui apprend de chaque action pour automatiser l'excellence.
            </p>
            <div class="flex flex-col sm:flex-row gap-6 justify-center opacity-0" id="hero-actions">
                <a href="{{ path('app_landing') }}" class="bg-white text-black px-12 py-5 rounded-full font-black text-sm uppercase tracking-wider hover:scale-105 transition-transform no-underline">Accéder au Terminal</a>
                <button class="border border-white/10 hover:bg-white/5 px-12 py-5 rounded-full font-black text-sm uppercase tracking-wider">Visionner le Manifeste</button>
            </div>
        </div>

        <div class="absolute bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center gap-4 opacity-30 animate-bounce">
            <span class="text-[9px] font-bold uppercase tracking-[0.4em]">Scroll</span>
            <div class="w-[1px] h-8 bg-blue-500"></div>
        </div>
    </section>

    <!-- Section Logos Marquee -->
    <section class="py-24 border-y border-white/5 bg-black/50 overflow-hidden">
        <div class="marquee-line" id="marquee">
            <span class="text-2xl font-bold opacity-20">MISTRAL_AI</span>
            <span class="text-2xl font-bold opacity-20">HUGGING_FACE</span>
            <span class="text-2xl font-bold opacity-20">DEEPMIND</span>
            <span class="text-2xl font-bold opacity-20">OPEN_AI</span>
            <span class="text-2xl font-bold opacity-20">ANTHROPIC</span>
            <span class="text-2xl font-bold opacity-20">NVIDIA_GTC</span>
            <!-- Duplicate for loop -->
            <span class="text-2xl font-bold opacity-20">MISTRAL_AI</span>
            <span class="text-2xl font-bold opacity-20">HUGGING_FACE</span>
            <span class="text-2xl font-bold opacity-20">DEEPMIND</span>
            <span class="text-2xl font-bold opacity-20">OPEN_AI</span>
            <span class="text-2xl font-bold opacity-20">ANTHROPIC</span>
            <span class="text-2xl font-bold opacity-20">NVIDIA_GTC</span>
        </div>
    </section>

    <!-- Section Live Terminal -->
    <section class="py-32 px-6 max-w-6xl mx-auto">
        <div class="terminal-window rounded-2xl overflow-hidden">
            <div class="bg-zinc-800/50 px-6 py-3 flex items-center gap-2 border-b border-white/5">
                <div class="w-3 h-3 rounded-full bg-red-500/50"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500/50"></div>
                <div class="w-3 h-3 rounded-full bg-green-500/50"></div>
                <span class="ml-4 text-[10px] font-mono opacity-40 uppercase tracking-widest">nexa-os // core_v3.sh</span>
            </div>
            <div class="p-8 md:p-12 font-mono text-sm md:text-base text-blue-400/80 leading-relaxed min-h-[400px]" id="terminal-body">
                <span class="text-green-500">user@nexa:~$</span> <span id="typing-text"></span><span class="typing-cursor"></span>
            </div>
        </div>
    </section>

    <!-- Section 2: Horizontal Scroll (Interface) -->
    <section id="horizontal" class="horizontal-scroll-section overflow-hidden">
        <div class="horizontal-container">
            <div class="horizontal-panel">
                <div class="max-w-5xl grid md:grid-cols-2 gap-20 items-center">
                    <div class="text-[15rem] font-black text-blue-500/10 select-none">01</div>
                    <div class="reveal-content opacity-0 translate-y-20">
                        <h2 class="text-6xl font-bold mb-8 tracking-tighter">Unified <br>Intelligence</h2>
                        <p class="text-slate-400 text-xl leading-relaxed">NEXA n'est pas un outil, c'est une extension de votre esprit. Elle synchronise vos pensées et vos données en millisecondes.</p>
                    </div>
                </div>
            </div>
            <div class="horizontal-panel">
                <div class="max-w-5xl grid md:grid-cols-2 gap-20 items-center">
                    <div class="text-[15rem] font-black text-blue-500/10 select-none">02</div>
                    <div>
                        <h2 class="text-6xl font-bold mb-8 tracking-tighter">Predictive <br>Engine</h2>
                        <p class="text-slate-400 text-xl leading-relaxed">Identifiez les opportunités avant la concurrence. Notre moteur analyse les signaux faibles pour vous.</p>
                    </div>
                </div>
            </div>
            <div class="horizontal-panel">
                <div class="max-w-5xl grid md:grid-cols-2 gap-20 items-center">
                    <div class="text-[15rem] font-black text-blue-500/10 select-none">03</div>
                    <div>
                        <h2 class="text-6xl font-bold mb-8 tracking-tighter">Zero-Trust <br>Security</h2>
                        <p class="text-slate-400 text-xl leading-relaxed">Vos secrets sont sacrés. Chaque octet est protégé par une encryption quantique-ready.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Section Stats -->
    <section id="stats" class="py-40 bg-zinc-900/30 border-y border-white/5">
        <div class="max-w-7xl mx-auto px-6 grid grid-cols-2 md:grid-cols-4 gap-12 text-center">
            <div>
                <div class="text-5xl md:text-7xl font-black mb-2 stat-number" data-target="99">0</div>
                <div class="text-[10px] font-bold uppercase tracking-widest opacity-40">Uptime %</div>
            </div>
            <div>
                <div class="text-5xl md:text-7xl font-black mb-2 stat-number" data-target="450">0</div>
                <div class="text-[10px] font-bold uppercase tracking-widest opacity-40">ms Latence</div>
            </div>
            <div>
                <div class="text-5xl md:text-7xl font-black mb-2 stat-number" data-target="12">0</div>
                <div class="text-[10px] font-bold uppercase tracking-widest opacity-40">M Utilisateurs</div>
            </div>
            <div>
                <div class="text-5xl md:text-7xl font-black mb-2 stat-number" data-target="24">0</div>
                <div class="text-[10px] font-bold uppercase tracking-widest opacity-40">Pays</div>
            </div>
        </div>
    </section>

    <!-- Section Architecture (Stacking Cards) -->
    <section id="architecture" class="py-32 px-6 bg-white text-black rounded-t-[4rem] relative z-10">
        <div class="max-w-4xl mx-auto">
            <div class="mb-24">
                <h2 class="text-7xl font-black mb-8 tracking-tighter">L'Architecture <br>Cognitive.</h2>
                <p class="text-slate-500 text-xl max-w-xl">Une structure modulaire conçue pour s'adapter à l'évolution constante de vos besoins technologiques.</p>
            </div>
            
            <div class="space-y-[30vh] pb-[20vh]">
                <div class="stack-card bg-slate-50 p-12 rounded-[3rem] border border-slate-200 shadow-2xl">
                    <div class="text-xs font-bold text-blue-600 mb-6 uppercase tracking-[0.3em]">Niveau 01</div>
                    <h3 class="text-4xl font-bold mb-8 tracking-tight">Le Noyau Vectoriel</h3>
                    <p class="text-slate-600 text-lg leading-relaxed">Une infrastructure de données qui ne se contente pas de stocker, mais comprend le contexte sémantique de chaque document.</p>
                    <div class="mt-12 h-1 bg-slate-200 rounded-full overflow-hidden">
                        <div class="h-full bg-blue-600 w-1/3"></div>
                    </div>
                </div>

                <div class="stack-card bg-zinc-900 text-white p-12 rounded-[3rem] shadow-2xl">
                    <div class="text-xs font-bold text-blue-400 mb-6 uppercase tracking-[0.3em]">Niveau 02</div>
                    <h3 class="text-4xl font-bold mb-8 tracking-tight">L'Intelligence Distribuée</h3>
                    <p class="text-slate-400 text-lg leading-relaxed">Des milliers d'agents spécialisés travaillant de concert pour résoudre vos problèmes complexes en un temps record.</p>
                </div>

                <div class="stack-card bg-blue-600 text-white p-12 rounded-[3rem] shadow-2xl shadow-blue-500/50">
                    <div class="text-xs font-bold text-white/60 mb-6 uppercase tracking-[0.3em]">Niveau 03</div>
                    <h3 class="text-4xl font-bold mb-8 tracking-tight">Interface Neuronale UX</h3>
                    <p class="text-white/80 text-lg leading-relaxed">Une interface qui anticipe vos mouvements et réduit la friction entre l'idée et l'exécution.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Section Final: Reveal CTA -->
    <footer class="h-screen flex flex-col justify-center items-center text-center bg-black px-6 relative overflow-hidden">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-blue-600/10 rounded-full blur-[120px] pointer-events-none"></div>
        
        <div class="reveal-container z-10">
            <h2 class="text-7xl md:text-[10rem] font-black mb-12 tracking-tighter" id="scramble-text">INITIALISER NEXA</h2>
            <a href="{{ path('app_landing') }}" class="group relative px-16 py-8 bg-white text-black rounded-full overflow-hidden transition-all hover:scale-105 active:scale-95 no-underline inline-block">
                <span class="relative z-10 font-black text-2xl uppercase tracking-widest">Prendre le contrôle</span>
            </a>
        </div>
        
        <div class="absolute bottom-12 w-full px-12 flex flex-col md:flex-row justify-between items-center text-[10px] font-bold uppercase tracking-widest opacity-30 gap-6">
            <p>© 2026 nexa_os. all rights reserved.</p>
            <div class="flex gap-10">
                <a href="#">privacy_protocol</a>
                <a href="#">service_terms</a>
            </div>
            <p>status: operational // 24.02.2026</p>
        </div>
    </footer>

    <script>
        window.addEventListener('load', () => {
            gsap.registerPlugin(ScrollTrigger, TextPlugin);

            // 1. Glow effect following mouse
            const glow = document.getElementById('glow');
            window.addEventListener('mousemove', (e) => {
                gsap.to(glow, {
                    x: e.clientX,
                    y: e.clientY,
                    duration: 1,
                    ease: "power2.out"
                });
            });

            // 2. Hero Animation
            const tl = gsap.timeline();
            tl.to("#hero-tag", { opacity: 1, y: 0, duration: 1 })
              .from("#main-title", {
                y: 150,
                rotateX: -30,
                opacity: 0,
                duration: 1.5,
                ease: "expo.out"
            }, "-=0.5")
              .to("#hero-sub", { opacity: 1, y: 0, duration: 1 }, "-=1")
              .to("#hero-actions", { opacity: 1, y: 0, duration: 1 }, "-=0.8");

            // 3. Marquee Loop
            gsap.to("#marquee", {
                xPercent: -50,
                repeat: -1,
                duration: 25,
                ease: "none"
            });

            // 4. Typing Terminal Animation
            const terminalText = "initialisation du noyau NEXA_V3... OK\nconnexion au réseau neuronal... OK\nanalyse des flux de travail... 100%\noptimisation cognitive activée.\nprêt pour l'exécution globale.";
            gsap.to("#typing-text", {
                duration: 4,
                text: terminalText,
                ease: "none",
                scrollTrigger: {
                    trigger: "#terminal-body",
                    start: "top 80%",
                }
            });

            // 5. Horizontal Scroll
            const horizontalContainer = document.querySelector(".horizontal-container");
            gsap.to(horizontalContainer, {
                x: () => -(horizontalContainer.scrollWidth - window.innerWidth),
                ease: "none",
                scrollTrigger: {
                    trigger: ".horizontal-scroll-section",
                    start: "top top",
                    end: () => "+=" + horizontalContainer.scrollWidth,
                    scrub: 1,
                    pin: true,
                    anticipatePin: 1
                }
            });

            // 6. Stats Counter
            document.querySelectorAll(".stat-number").forEach(num => {
                const target = parseInt(num.dataset.target);
                gsap.to(num, {
                    innerText: target,
                    duration: 2,
                    snap: { innerText: 1 },
                    scrollTrigger: {
                        trigger: num,
                        start: "top 90%",
                    }
                });
            });

            // 7. Stacking Cards with Tilt
            const cards = gsap.utils.toArray(".stack-card");
            cards.forEach((card, i) => {
                // Pinning logic
                gsap.to(card, {
                    scrollTrigger: {
                        trigger: card,
                        start: "top 15%",
                        endTrigger: "Architecture",
                        end: "bottom top",
                        pin: true,
                        pinSpacing: false,
                        scrub: true
                    },
                    scale: 1 - (cards.length - i) * 0.04,
                    filter: `blur(${ (cards.length - i - 1) * 2 }px)`,
                });

                // Mouse move tilt effect
                card.addEventListener('mousemove', (e) => {
                    const { left, top, width, height } = card.getBoundingClientRect();
                    const x = (e.clientX - left - width / 2) / 30;
                    const y = (e.clientY - top - height / 2) / 30;
                    gsap.to(card, { rotationY: x, rotationX: -y, transformPerspective: 1000, duration: 0.4 });
                });
                card.addEventListener('mouseleave', () => {
                    gsap.to(card, { rotationY: 0, rotationX: 0, duration: 0.6 });
                });
            });

            // 8. Text Scramble on Footer
            const scrambleTarget = document.getElementById("scramble-text");
            if (scrambleTarget && typeof gsap.plugins.scrambleText !== 'undefined') {
                const originalText = scrambleTarget.innerText;
                ScrollTrigger.create({
                    trigger: scrambleTarget,
                    start: "top 80%",
                    onEnter: () => {
                        gsap.to(scrambleTarget, {
                            duration: 1.5,
                            scrambleText: {
                                text: originalText,
                                chars: "01ABCDEFGH-",
                                revealDelay: 0.2,
                                speed: 0.4
                            }
                        });
                    }
                });
            }
        });
    </script>
</body>
</html>
