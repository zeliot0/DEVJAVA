{% extends 'base.html.twig' %}

{% block title %}MUTATION PHOENIX #{{ phoenix_goal.id }} — NEXA Intelligence{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/phoenix-goal-modern.css?v=' ~ 'now'|date('U')) }}">
{% endblock %}

{% block body %}
<div class="pg-page">

    <header class="pg-header">
        <div class="pg-header-left">
            <div style="font-size: 11px; font-weight: 800; color: var(--pg-orange); text-transform: uppercase; letter-spacing: 0.2em; margin-bottom: 8px;">Ajustement de Cycle</div>
            <h1 class="pg-title">Mutation Instance #{{ phoenix_goal.id }}</h1>
            <p>Modification des vecteurs de résilience et de l'analyse post-mortem.</p>
        </div>
        <div class="pg-header-right">
            <a href="{{ path('app_phoenix_goal_show', {id: phoenix_goal.id}) }}" class="pg-btn pg-btn-secondary">
                <i class="fas fa-eye"></i> Spécifications
            </a>
            <a href="{{ path('app_phoenix_goal_index') }}" class="pg-btn pg-btn-secondary">
                <i class="fas fa-arrow-left"></i> Index
            </a>
        </div>
    </header>

    <div class="pg-form-wrap">
        {{ include('phoenix_goal/_form.html.twig', {'button_label': 'Appliquer les Mutations'}) }}
    </div>

</div>
{% endblock %}
