{% extends 'base.html.twig' %}

{% set body_class = 'conscience-page' %}

{% block title %}MUTATION SAGESSE — NEXA Intelligence{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/phoenix-wisdom-premium.css?v=' ~ 'now'|date('U')) }}">
{% endblock %}

{% block body %}
<div class="wisdom-page">
    <header class="wisdom-header">
        <div>
            <h1 class="wisdom-title"><i class="fa-solid fa-pen-fancy"></i> Mutation d'Archive</h1>
            <p style="margin: 8px 0 0; font-size: 16px; color: var(--notion-text-muted);">Ajustement des paramètres de la leçon <strong>#{{ phoenix_wisdom.id }}</strong></p>
        </div>
        <div style="display: flex; gap: 12px;">
            <a href="{{ path('app_phoenix_wisdom_show', {id: phoenix_wisdom.id}) }}" class="btn">
                ← Retour
            </a>
            {{ include('phoenix_wisdom/_delete_form.html.twig') }}
        </div>
    </header>

    {{ include('phoenix_wisdom/_form.html.twig', {'button_label': 'Appliquer les Pensées'}) }}
</div>
{% endblock %}
