{% extends 'admin/base.html.twig' %}

{% block admin_page_title %}Profil Utilisateur{% endblock %}
{% block admin_page_hint %}Details du compte selectionne{% endblock %}

{% block stylesheets %}
<style>
    .user-show-wrap {
        max-width: 920px;
        margin: 0 auto;
    }

    .user-show-panel {
        border: 1px solid rgba(167, 139, 250, 0.24);
        border-radius: 26px;
        background:
            linear-gradient(165deg, rgba(255, 255, 255, 0.9), rgba(248, 251, 255, 0.84));
        box-shadow:
            0 22px 40px rgba(15, 23, 42, 0.1),
            inset 0 1px 0 rgba(255, 255, 255, 0.86);
    }

    .user-show-head {
        display: grid;
        grid-template-columns: 82px 1fr auto;
        align-items: center;
        gap: 14px;
        padding: 14px;
        border: 1px solid rgba(167, 139, 250, 0.2);
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.72);
        margin-bottom: 14px;
    }

    .user-show-avatar {
        width: 82px;
        height: 82px;
        border-radius: 20px;
        overflow: hidden;
        border: 1px solid rgba(99, 102, 241, 0.28);
        background: linear-gradient(135deg, #5b5cf0, #7c3aed);
        color: #fff;
        display: grid;
        place-items: center;
        font-size: 1.6rem;
        font-weight: 900;
        box-shadow: 0 12px 20px rgba(91, 92, 240, 0.2);
    }

    .user-show-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
    }

    .user-show-name {
        font-size: 1.35rem;
        font-weight: 900;
        color: #0f172a;
        line-height: 1.2;
    }

    .user-show-email {
        margin-top: 2px;
        color: #64748b;
        font-weight: 700;
    }

    .user-show-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 12px;
        border-radius: 999px;
        font-size: 0.76rem;
        font-weight: 900;
        letter-spacing: 0.03em;
        border: 1px solid rgba(16, 185, 129, 0.28);
        color: #0f766e;
        background: rgba(16, 185, 129, 0.12);
    }

    .user-show-status.blocked {
        border-color: rgba(239, 68, 68, 0.3);
        color: #b91c1c;
        background: rgba(239, 68, 68, 0.12);
    }

    .user-show-table .adm-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 10px;
    }

    .user-show-table .adm-table td {
        background: rgba(255, 255, 255, 0.75);
        border-top: 1px solid rgba(167, 139, 250, 0.14);
        border-bottom: 1px solid rgba(167, 139, 250, 0.14);
        padding: 14px 16px;
    }

    .user-show-table .adm-table td:first-child {
        width: 220px;
        color: #64748b;
        font-weight: 800;
        border-left: 1px solid rgba(167, 139, 250, 0.14);
        border-radius: 14px 0 0 14px;
    }

    .user-show-table .adm-table td:last-child {
        color: #0f172a;
        font-size: 1.04rem;
        font-weight: 900;
        border-right: 1px solid rgba(167, 139, 250, 0.14);
        border-radius: 0 14px 14px 0;
    }

    .role-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 11px;
        border-radius: 999px;
        margin-right: 8px;
        margin-bottom: 6px;
        font-size: 0.74rem;
        font-weight: 900;
        border: 1px solid rgba(99, 102, 241, 0.24);
        color: #4f46e5;
        background: rgba(99, 102, 241, 0.1);
    }

    .user-show-actions {
        margin-top: 18px;
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn-danger-soft {
        color: #b91c1c;
        border-color: rgba(239, 68, 68, 0.3);
        background: rgba(239, 68, 68, 0.08);
    }

    .btn-success-soft {
        color: #0f766e;
        border-color: rgba(16, 185, 129, 0.3);
        background: rgba(16, 185, 129, 0.08);
    }

    @media (max-width: 820px) {
        .user-show-head {
            grid-template-columns: 1fr;
            justify-items: center;
            text-align: center;
        }

        .user-show-table .adm-table td:first-child,
        .user-show-table .adm-table td:last-child {
            display: block;
            width: auto;
            border-radius: 0;
            border-left: 1px solid rgba(167, 139, 250, 0.14);
            border-right: 1px solid rgba(167, 139, 250, 0.14);
        }

        .user-show-table .adm-table td:first-child {
            border-radius: 12px 12px 0 0;
            border-bottom: 0;
        }

        .user-show-table .adm-table td:last-child {
            border-radius: 0 0 12px 12px;
            border-top: 0;
        }
    }
</style>
{% endblock %}

{% block admin_content %}
    <div class="user-show-wrap">
    <div class="panel user-show-panel">
        <div class="panel-title">
            <i class="fa-solid fa-user" style="color: var(--primary);"></i>
            Informations du compte
        </div>

        <div class="user-show-head">
            <div class="user-show-avatar">
                {% if user.profilePhoto %}
                    <img src="{{ asset('uploads/profiles/' ~ user.profilePhoto) }}" alt="Photo de {{ user.nom }}">
                {% else %}
                    {{ (user.nom ?? user.email)|first|upper }}
                {% endif %}
            </div>
            <div>
                <div class="user-show-name">{{ user.nom }}</div>
                <div class="user-show-email">{{ user.email }}</div>
            </div>
            <span class="user-show-status {{ user.isBlocked ? 'blocked' : '' }}">
                <i class="fa-solid {{ user.isBlocked ? 'fa-lock' : 'fa-lock-open' }}"></i>
                {{ user.isBlocked ? 'BLOQUE' : 'ACTIF' }}
            </span>
        </div>

        <div class="user-show-table">
        <table class="adm-table">
            <tbody>
                <tr>
                    <td>Identifiant</td>
                    <td>#USR-{{ user.id }}</td>
                </tr>
                <tr>
                    <td>Nom</td>
                    <td>{{ user.nom }}</td>
                </tr>
                <tr>
                    <td>Email</td>
                    <td>{{ user.email }}</td>
                </tr>
                <tr>
                    <td>Roles</td>
                    <td>
                        {% for role in user.roles %}
                            <span class="role-pill">
                                <i class="fa-solid fa-shield-halved"></i>
                                {{ role|replace({'ROLE_': ''}) }}
                            </span>
                        {% else %}
                            <span class="role-pill">
                                <i class="fa-solid fa-user"></i>
                                USER
                            </span>
                        {% endfor %}
                    </td>
                </tr>
            </tbody>
        </table>
        </div>

        <div class="user-show-actions">
            <a href="{{ path('app_user_list') }}" class="btn-adm">
                <i class="fa-solid fa-arrow-left"></i> Retour a la liste
            </a>
            <form method="post" action="{{ path('app_user_toggle_block', {id: user.id}) }}" style="display:inline;">
                <input type="hidden" name="_token" value="{{ csrf_token('toggle_block_user_' ~ user.id) }}">
                <button type="submit" class="btn-adm {{ user.isBlocked ? 'btn-success-soft' : 'btn-danger-soft' }}">
                    <i class="fa-solid {{ user.isBlocked ? 'fa-unlock' : 'fa-ban' }}"></i>
                    {{ user.isBlocked ? 'Debloquer le compte' : 'Bloquer le compte' }}
                </button>
            </form>
        </div>
    </div>
    </div>
{% endblock %}
