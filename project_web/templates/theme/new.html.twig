{% extends 'theme/base.html.twig' %}

{% set body_class = 'conscience-page' %}

{% block title %}NOUVELLE INSTANCE — NEXA Intelligence{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/conscience-modern-proo.css?v=' ~ 'now'|date('U')) }}">
{% endblock %}

{% block body %}
<div class="conscience-modern-page">

    <header class="conscience-page-header">
        <div>
            <div style="font-size: 11px; font-weight: 800; color: var(--notion-text-muted); text-transform: uppercase; letter-spacing: 0.2em; margin-bottom: 8px;">Initialisation de Module</div>
            <h1 style="font-family: 'Space Grotesk', sans-serif;">Nouveau Thème d'Intelligence</h1>
            <p>Définissez les paramètres systémiques et l'intention du nouveau module de monitoring.</p>
        </div>
        <div style="margin-top: 24px;">
            <a href="{{ path('app_conscience_index') }}" class="btn">
                <i class="fas fa-arrow-left"></i> Annuler l'opération
            </a>
        </div>
    </header>

    <div class="pg-form-wrap">
        {{ include('theme/_form.html.twig', {'button_label': 'Initialiser le Module'}) }}
    </div>

</div>
{% endblock %}
