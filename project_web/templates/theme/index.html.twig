{% extends 'theme/base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/conscience-modern-proo.css?v=' ~ 'now'|date('U')) }}">
{% endblock %}

{% block title %}Gestion des Thèmes — NEXA{% endblock %}

{% block body %}
<div class="conscience-modern-page theme-management-page">

<header class="conscience-page-header">
    <h1>Gestion des Thèmes</h1>
    <p>Architecture du système de monitoring et configuration des modules</p>
</header>

<div class="conscience-header-actions" style="margin-bottom: 24px;">
    <div class="page-actions">
        <a href="{{ path('app_theme_new') }}" class="btn primary">Nouveau Thème</a>
        <a href="{{ path('app_conscience_index') }}" class="btn">Retour Conscience</a>
    </div>
</div>

<form method="get" action="{{ path('app_theme_index') }}" class="search-bar conscience-toolbar">
    <div class="conscience-search-box">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" name="q" value="{{ search }}" placeholder="Rechercher un module..." class="search-input" autocomplete="off">
    </div>
</form>

<div class="section-title" style="margin-top: 32px; margin-bottom: 12px; font-size: 11px; font-weight: 700; color: #3b82f6; text-transform: uppercase; letter-spacing: 0.05em; border-left: 2px solid #3b82f6; padding-left: 8px;">Indicateurs Structurels</div>
<section class="kpi-grid">
    <div class="kpi-card command-stat-card" style="border-top: 3px solid #3b82f6; background: #f5faff;">
        <div class="card-label">TOTAL THEMES</div>
        <div class="card-main-val">{{ themes|length }}</div>
        <div class="card-sub-val">Modules enregistrés</div>
    </div>

    <div class="kpi-card command-stat-card" style="border-top: 3px solid #10b981; background: #f2fff9;">
        <div class="card-label">THEMES ACTIFS</div>
        <div class="card-main-val">{{ themes|filter(t => t.actif)|length }}</div>
        <div class="card-sub-val">Modules opérationnels</div>
    </div>
</section>

<div class="section-title" style="margin-top: 32px; margin-bottom: 12px; font-size: 11px; font-weight: 700; color: #8b5cf6; text-transform: uppercase; letter-spacing: 0.05em; border-left: 2px solid #8b5cf6; padding-left: 8px;">Répertoire des Modules</div>
<section class="themes-grid" id="themes-container">
    {% include 'theme/_themes_list.html.twig' with { themes: themes } %}
</section>

</div>

<!-- ================= JS : SEARCH ================= -->
<script>
document.addEventListener('DOMContentLoaded', () => {
    const input = document.querySelector('.search-input');
    const container = document.getElementById('themes-container');

    let timeout = null;

    input.addEventListener('input', () => {
        clearTimeout(timeout);

        timeout = setTimeout(() => {
            fetch(`{{ path('app_theme_index') }}?q=` + encodeURIComponent(input.value), {
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.text())
            .then(html => {
                container.innerHTML = html;
            });
        }, 250);
    });
});
</script>

{% endblock %}
