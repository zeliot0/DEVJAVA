{% extends 'theme/base.html.twig' %}

{% set body_class = 'conscience-page' %}

{% block title %}MUTATION MODULE #{{ theme.idT }} — NEXA Intelligence{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/conscience-modern-proo.css?v=' ~ 'now'|date('U')) }}">
{% endblock %}

{% block body %}
<div class="conscience-modern-page">

    <header class="conscience-page-header">
        <div>
            <div style="font-size: 11px; font-weight: 800; color: var(--notion-text-muted); text-transform: uppercase; letter-spacing: 0.2em; margin-bottom: 8px;">Ajustement de Registre</div>
            <h1 style="font-family: 'Space Grotesk', sans-serif;">Mutation : {{ theme.nom }}</h1>
            <p>Révision des paramètres stratégiques et de l'identité visuelle du module.</p>
        </div>
        <div style="display: flex; gap: 12px; margin-top: 24px;">
            <a href="{{ path('app_theme_show', { id: theme.idT }) }}" class="btn">
                <i class="fas fa-eye"></i> Spécifications
            </a>
            <a href="{{ path('app_conscience_index') }}" class="btn">
                <i class="fas fa-arrow-left"></i> Hub
            </a>
        </div>
    </header>

    <div class="pg-form-wrap">
        {{ include('theme/_form.html.twig', {'button_label': 'Appliquer les Mutations'}) }}
    </div>

</div>
{% endblock %}
