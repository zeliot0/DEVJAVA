{% for theme in themes %}
    {% set pr = theme.priorite ?? 2 %}
    {% set prClass = pr >= 4 ? 'critical' : (pr == 3 ? 'high' : (pr == 2 ? 'medium' : 'low')) %}
    
    <article class="theme-card conscience-theme-card" data-theme-id="{{ theme.idT }}">
        <div class="conscience-card-top">
            <div class="conscience-card-main">
                <div class="conscience-theme-icon" style="--theme-color: {{ theme.couleur ?: '#8b5cf6' }};">
                    {% if theme.icone and (theme.icone starts with 'fa') %}
                        <i class="{{ theme.icone }}"></i>
                    {% else %}
                        {{ theme.icone|default('<i class="fa-solid fa-brain"></i>')|raw }}
                    {% endif %}
                </div>
                <div class="conscience-theme-info">
                    <h3>{{ theme.nom }}</h3>
                    <span>{{ theme.createdAt|date('d/m/Y') }}</span>
                </div>
            </div>
            <div class="conscience-card-actions">
                <span class="theme-status {{ theme.actif ? 'active' : 'inactive' }}">
                    {{ theme.actif ? 'Actif' : 'Inactif' }}
                </span>
            </div>
        </div>

        <p class="conscience-theme-text" style="margin: 12px 0; font-size: 13px; color: var(--notion-text-muted); line-height: 1.4;">
            {{ theme.intention ?? 'Module de monitoring système sans description spécifique.' }}
        </p>

        <div class="conscience-card-bottom">
            <div class="conscience-meta">
                <span class="conscience-meta-pill">
                    <strong>{{ theme.questions|length }}</strong> questions
                </span>
                <span class="conscience-meta-pill conscience-priority {{ prClass }}">
                    P{{ pr }}
                </span>
            </div>

            <div class="conscience-actions">
                <!-- VIEW QUESTIONS -->
                <a href="{{ path('app_questions_by_theme', { id: theme.idT }) }}" class="conscience-action" title="Voir les questions">
                    Questions
                </a>

                <!-- EDIT -->
                <a href="{{ path('app_theme_edit', { id: theme.idT }) }}" class="conscience-action" title="Modifier">
                    Modifier
                </a>

                <!-- DELETE -->
                <form method="post" action="{{ path('app_theme_delete', { id: theme.idT }) }}" onsubmit="return confirm('Supprimer ce module ? cette action est irréversible.')" style="display:inline;">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ theme.idT) }}">
                    <button type="submit" class="conscience-action" style="background: transparent; border: none; font-family: inherit; cursor: pointer; color: #eb5757;">
                        Supprimer
                    </button>
                </form>
            </div>
        </div>
    </article>
{% else %}
    <div style="grid-column: 1/-1; text-align: center; padding: 48px; background: white; border-radius: 8px; border: 1px dashed #efefef;">
        <p style="color: var(--notion-text-muted); font-size: 14px;">Aucun module trouvé dans le répertoire.</p>
    </div>
{% endfor %}
