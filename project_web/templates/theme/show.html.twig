{% extends 'theme/base.html.twig' %}

{% set body_class = 'conscience-page' %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/conscience-modern-proo.css?v=' ~ 'now'|date('U')) }}">
{% endblock %}

{% block title %}TRACE MODULE #{{ theme.idT }} — NEXA Intelligence{% endblock %}

{% block body %}
<div class="conscience-modern-page">

    <header class="conscience-page-header">
        <div>
            <div style="font-size: 11px; font-weight: 800; color: var(--notion-text-muted); text-transform: uppercase; letter-spacing: 0.2em; margin-bottom: 8px;">Analyse de Module</div>
            <h1 style="font-family: 'Space Grotesk', sans-serif;">{{ theme.nom }}</h1>
            <p>Spécifications et configuration systémique du module de monitoring.</p>
        </div>
        <div style="display: flex; gap: 12px; margin-top: 24px;">
            <a href="{{ path('app_conscience_index') }}" class="btn">
                <i class="fas fa-arrow-left"></i> Hub
            </a>
            <a href="{{ path('app_theme_edit', { id: theme.idT }) }}" class="btn">
                <i class="fas fa-pen"></i> Modifier
            </a>
            <a href="{{ path('app_questions_by_theme', { id: theme.idT }) }}" class="btn primary">
                <i class="fas fa-list-check"></i> Gérer les points de capture
            </a>
        </div>
    </header>

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 40px;">
        <div class="main-column">
            <div class="section-title" style="margin-bottom: 24px; font-size: 11px; font-weight: 800; color: var(--nexa-indigo); text-transform: uppercase; letter-spacing: 0.2em;">EXTRACTION D'INTENTION</div>
            
            <div style="background: white; border: 1px solid var(--notion-border); border-radius: 24px; padding: 40px; box-shadow: var(--card-shadow); margin-bottom: 40px;">
                <div style="margin-bottom: 32px;">
                    <label style="font-size: 10px; font-weight: 800; color: #9ca3af; text-transform: uppercase; display: block; margin-bottom: 8px;">VISION DU MODULE</label>
                    <div style="font-size: 18px; font-weight: 600; line-height: 1.6; color: #1a1b23;">
                        {{ theme.intention ?? 'Aucune intention stratégique définie.' }}
                    </div>
                </div>
                
                <div style="padding-top: 32px; border-top: 1px solid #f3f4f6;">
                    <label style="font-size: 10px; font-weight: 800; color: #9ca3af; text-transform: uppercase; display: block; margin-bottom: 8px;">DESCRIPTION TECHNIQUE</label>
                    <div style="font-size: 15px; line-height: 1.7; color: #4b5563;">
                        {{ theme.description_q ?? 'Aucune spécification technique enregistrée.' }}
                    </div>
                </div>
            </div>

            <div class="section-title" style="margin-bottom: 24px; font-size: 11px; font-weight: 800; color: #10b981; text-transform: uppercase; letter-spacing: 0.2em;">INTERFACE VISUELLE</div>
            <div style="background: #f9fafb; border: 1px solid var(--notion-border); border-radius: 20px; padding: 32px; display: flex; align-items: center; gap: 32px;">
                <div style="width: 80px; height: 80px; border-radius: 20px; background: {{ theme.couleur ?: '#6366f1' }}; color: white; display: flex; align-items: center; justify-content: center; font-size: 32px; box-shadow: 0 10px 20px -5px {{ theme.couleur ?: '#6366f1' }}66;">
                    {% if theme.icone and (theme.icone starts with 'fa') %}
                        <i class="{{ theme.icone }}"></i>
                    {% else %}
                        {{ theme.icone|default('<i class="fa-solid fa-brain"></i>')|raw }}
                    {% endif %}
                </div>
                <div>
                    <div style="font-size: 12px; font-weight: 800; color: #6b7280; text-transform: uppercase; margin-bottom: 4px;">SIGNATURE CHROMATIQUE</div>
                    <code style="font-size: 16px; font-weight: 700; color: #1a1b23;">{{ theme.couleur ?: '#6366f1' }}</code>
                </div>
            </div>
        </div>

        <div class="sidebar-column">
            <div class="section-title" style="margin-bottom: 24px; font-size: 11px; font-weight: 800; color: #f59e0b; text-transform: uppercase; letter-spacing: 0.2em;">MÉTADONNÉES</div>
            
            <div style="background: white; border: 1px solid var(--notion-border); border-radius: 20px; padding: 32px; box-shadow: var(--card-shadow); display: flex; flex-direction: column; gap: 32px;">
                <div>
                    <label style="font-size: 10px; font-weight: 800; color: #9ca3af; text-transform: uppercase; display: block; margin-bottom: 4px;">IDENTIFIANT</label>
                    <div style="font-size: 20px; font-weight: 800;">#{{ theme.idT }}</div>
                </div>
                <div>
                    <label style="font-size: 10px; font-weight: 800; color: #9ca3af; text-transform: uppercase; display: block; margin-bottom: 4px;">STATUT</label>
                    <span style="display: inline-block; padding: 4px 12px; border-radius: 100px; font-size: 11px; font-weight: 800; background: {{ theme.actif ? '#dcfce7' : '#f3f4f6' }}; color: {{ theme.actif ? '#166534' : '#6b7280' }};">
                        {{ theme.actif ? 'ACTIF' : 'DÉSACTIVÉ' }}
                    </span>
                </div>
                <div>
                    <label style="font-size: 10px; font-weight: 800; color: #9ca3af; text-transform: uppercase; display: block; margin-bottom: 4px;">PRIORITÉ SYSTÈME</label>
                    <div style="font-size: 18px; font-weight: 700; color: #f59e0b;">{{ theme.priorite ?? 2 }} / 5</div>
                </div>
                <div style="padding-top: 24px; border-top: 1px solid #f3f4f6;">
                    <label style="font-size: 10px; font-weight: 800; color: #9ca3af; text-transform: uppercase; display: block; margin-bottom: 4px;">DATE DE CRÉATION</label>
                    <div style="font-size: 14px; font-weight: 600;">{{ theme.createdAt|date('d F Y') }}</div>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}
