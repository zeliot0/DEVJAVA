{{ form_start(form, { attr: { novalidate: 'novalidate', class: 'goal-modern-form' } }) }}

<div class="goal-form-stack">

    <section class="goal-card">
        <div class="goal-section-head">
            <span class="goal-section-bar goal-section-bar-orange"></span>
            <h2 class="goal-section-title">Identité stratégique</h2>
        </div>

        <div class="goal-field">
            {{ form_label(form.titleGoa, 'Désignation de l\'objectif *', {'label_attr': {'class': 'goal-label'}}) }}
            {{ form_widget(form.titleGoa, {'attr': {'class': 'goal-input', 'placeholder': 'Ex: Expansion du marché EU-27'}}) }}
            {{ form_errors(form.titleGoa) }}
        </div>

        <div class="goal-field">
            {{ form_label(form.descriptionGoa, 'Énoncé de vision *', {'label_attr': {'class': 'goal-label'}}) }}
            {{ form_widget(form.descriptionGoa, {'attr': {'class': 'goal-textarea', 'placeholder': 'Définissez la finalité de cet objectif...'}}) }}
            {{ form_errors(form.descriptionGoa) }}
        </div>

        <div class="goal-grid-two">
            <div class="goal-field">
                {{ form_label(form.categoryGoa, 'Domaine d\'influence *', {'label_attr': {'class': 'goal-label'}}) }}
                {{ form_widget(form.categoryGoa, {'attr': {'class': 'goal-input', 'placeholder': 'Ex: Infrastructure, Recherche...'}}) }}
                {{ form_errors(form.categoryGoa) }}
            </div>
            <div class="goal-field">
                {{ form_label(form.priorityGoa, 'Niveau de priorité *', {'label_attr': {'class': 'goal-label'}}) }}
                {{ form_widget(form.priorityGoa, {'attr': {'class': 'goal-select'}}) }}
                {{ form_errors(form.priorityGoa) }}
            </div>
        </div>
    </section>

    <section class="goal-card">
        <div class="goal-section-head">
            <span class="goal-section-bar goal-section-bar-violet"></span>
            <h2 class="goal-section-title">Chronologie et flux</h2>
        </div>

        <div class="goal-grid-two">
            <div class="goal-field">
                {{ form_label(form.dateDebutGoa, 'Point d\'origine', {'label_attr': {'class': 'goal-label'}}) }}
                {{ form_widget(form.dateDebutGoa, {'attr': {'class': 'goal-input'}}) }}
                {{ form_errors(form.dateDebutGoa) }}
            </div>
            <div class="goal-field">
                {{ form_label(form.dateFinalGoa, 'Horizon cible', {'label_attr': {'class': 'goal-label'}}) }}
                {{ form_widget(form.dateFinalGoa, {'attr': {'class': 'goal-input'}}) }}
                {{ form_errors(form.dateFinalGoa) }}
            </div>
        </div>

        <div class="goal-grid-two">
            <div class="goal-field">
                {{ form_label(form.statusGoa, 'État de synchronisation *', {'label_attr': {'class': 'goal-label'}}) }}
                {{ form_widget(form.statusGoa, {'attr': {'class': 'goal-select'}}) }}
                {{ form_errors(form.statusGoa) }}
            </div>
            <div class="goal-field">
                {{ form_label(form.progressGoa, 'Quota de complétion (%)', {'label_attr': {'class': 'goal-label'}}) }}
                {{ form_widget(form.progressGoa, {'attr': {'class': 'goal-input'}}) }}
                {{ form_errors(form.progressGoa) }}
            </div>
        </div>
    </section>

    <section class="goal-card">
        <div class="goal-section-head">
            <span class="goal-section-bar goal-section-bar-green"></span>
            <h2 class="goal-section-title">Archives et attributs</h2>
        </div>

        <div class="goal-field goal-field-last">
            {{ form_label(form.notesGoa, 'Notes de commandement', {'label_attr': {'class': 'goal-label'}}) }}
            {{ form_widget(form.notesGoa, {'attr': {'class': 'goal-textarea goal-textarea-sm', 'placeholder': 'Observations tactiques...'}}) }}
            {{ form_errors(form.notesGoa) }}
        </div>
    </section>

    <div class="goal-form-actions">
        <a href="{{ path('app_goal_index') }}" class="goal-new-btn goal-new-btn-secondary">Annuler</a>
        <button type="submit" class="goal-new-btn goal-new-btn-primary">
            {{ button_label|default('Valider la stratégie') }}
        </button>
    </div>
</div>

{{ form_end(form) }}
