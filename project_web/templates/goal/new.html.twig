{% extends 'base.html.twig' %}

{% set body_class = 'conscience-page' %}

{% block title %}NOUVEL OBJECTIF — NEXA Intelligence{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/goal-new-phoenix.css?v=' ~ 'now'|date('U')) }}">
{% endblock %}

{% block body %}
<div class="goal-new-page">
    <header class="goal-new-header">
        <div>
            <div class="goal-new-kicker">Protocole Goals</div>
            <h1 class="goal-new-title">
                <i class="fas fa-bullseye"></i> Nouveau Goal
            </h1>
            <p class="goal-new-subtitle">Créez un objectif avec une structure claire, une priorité nette et une trajectoire mesurable.</p>
        </div>
        <div class="goal-new-actions">
            <a href="{{ path('app_goal_index') }}" class="goal-new-btn goal-new-btn-secondary">
                <i class="fas fa-arrow-left"></i> Répertoire Goals
            </a>
        </div>
    </header>

    <div class="goal-new-form-wrap">
        {{ include('goal/_form.html.twig', {'button_label': 'Initialiser l\'Objectif'}) }}
    </div>
</div>
{% endblock %}
