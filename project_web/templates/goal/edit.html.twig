{% extends 'base.html.twig' %}

{% set body_class = 'conscience-page' %}

{% block title %}MISE À JOUR : {{ goal.titleGoa }} — NEXA Intelligence{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/goal-new-phoenix.css?v=' ~ 'now'|date('U')) }}">
    <style>
        .goal-edit-page {
            max-width: 1120px;
            margin: 0 auto;
            padding: 56px 22px 68px;
        }
        .goal-edit-title {
            margin: 0;
            font-size: clamp(36px, 5vw, 60px);
            font-weight: 800;
            letter-spacing: -0.04em;
            line-height: 1.04;
            background: linear-gradient(90deg, #0f172a 0%, #4f46e5 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .goal-edit-subtitle {
            margin: 14px 0 0;
            font-size: 20px;
            color: #94a3b8;
            font-weight: 600;
        }
        .goal-edit-toolbar {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            margin: 28px 0 34px;
        }
        .goal-edit-toolbar .goal-new-btn-primary {
            background: #2563eb;
            box-shadow: 0 12px 24px rgba(37, 99, 235, 0.22);
        }
        .goal-edit-toolbar .goal-new-btn-primary:hover {
            background: #1d4ed8;
        }
        .goal-edit-form-wrap {
            border-radius: 28px;
            border-color: #e2e8f0;
            box-shadow: 0 8px 26px rgba(15, 23, 42, 0.06);
            padding: 30px;
        }
        .goal-edit-form-wrap .goal-card {
            border: 1px solid #eef2ff;
            border-radius: 18px;
        }
        .goal-edit-form-wrap .goal-section-title {
            color: #334155;
        }
        .goal-edit-form-wrap .goal-section-bar-orange {
            background: #3b82f6;
        }
        .goal-edit-form-wrap .goal-section-bar-violet {
            background: #8b5cf6;
        }
        .goal-edit-form-wrap .goal-section-bar-green {
            background: #10b981;
        }
        .goal-edit-form-wrap .goal-input:focus,
        .goal-edit-form-wrap .goal-select:focus,
        .goal-edit-form-wrap .goal-textarea:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.18);
        }
        .goal-edit-form-wrap .goal-new-btn-primary {
            background: #2563eb;
            box-shadow: 0 10px 22px rgba(37, 99, 235, 0.24);
        }
        .goal-edit-form-wrap .goal-new-btn-primary:hover {
            background: #1d4ed8;
        }
        .goal-edit-toolbar .d-inline-flex .btn {
            border-radius: 12px;
            border: 1px solid #fecaca;
            background: #fff5f5;
            color: #dc2626;
            font-size: 14px;
            font-weight: 700;
            padding: 11px 18px;
        }
        .goal-edit-toolbar .d-inline-flex .btn:hover {
            background: #fee2e2;
        }
        .goal-success-popup {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(8px);
            z-index: 1000;
            display: none;
            align-items: center;
            justify-content: center;
        }
        .goal-success-popup.show {
            display: flex;
        }
        .goal-success-card {
            background: white;
            padding: 48px;
            border-radius: 24px;
            text-align: center;
            max-width: 500px;
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.3);
            animation: popupIn 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }
        @keyframes popupIn {
            from { opacity: 0; transform: scale(0.8); }
            to { opacity: 1; transform: scale(1); }
        }
        @media (max-width: 860px) {
            .goal-edit-subtitle {
                font-size: 17px;
            }
            .goal-edit-form-wrap {
                padding: 18px;
                border-radius: 20px;
            }
            .goal-edit-toolbar .goal-new-btn {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="goal-new-page goal-edit-page">
    <header>
        <h1 class="goal-edit-title">Commandeur d'Objectifs</h1>
        <p class="goal-edit-subtitle">Modification stratégique de l'objectif <strong>#{{ goal.idGoa }}</strong> et ajustement des paramètres de progression.</p>
    </header>

    <div class="goal-edit-toolbar">
        <a href="{{ path('app_goal_index') }}" class="goal-new-btn goal-new-btn-secondary">
            <i class="fas fa-arrow-left"></i> Retour au Répertoire
        </a>
        <a href="{{ path('app_goal_show', {id_g: goal.idGoa}) }}" class="goal-new-btn goal-new-btn-primary">
            <i class="fas fa-eye"></i> Voir la fiche
        </a>
        {% if not is_granted('ROLE_ADMIN') %}
            <div style="margin-left: auto;">
                {{ include('goal/_delete_form.html.twig') }}
            </div>
        {% endif %}
    </div>

    <div class="goal-new-form-wrap goal-edit-form-wrap">
        {{ include('goal/_form.html.twig', {'button_label': 'Enregistrer les modifications'}) }}
    </div>

    <div id="goalSuccessPopup" class="goal-success-popup">
        <div class="goal-success-card">
            <div style="font-size: 64px; margin-bottom: 24px;">🎉</div>
            <h2 style="font-weight: 800; color: #1a1b23; margin-bottom: 16px;">Vecteur Accomplis !</h2>
            <p style="color: #6b7280; line-height: 1.6; margin-bottom: 32px;">
                Vous avez atteint 100% de votre objectif. La matrice opérationnelle est synchronisée.
                N'oubliez pas, notre vision ultime est la liberation et le succes collectif.
            </p>
            <button type="button" class="goal-new-btn goal-new-btn-primary" id="closeGoalPopup" style="width: 100%; justify-content: center;">
                Fermer
            </button>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener("DOMContentLoaded", function () {
    const input = document.getElementById("goal_progressGoa");
    const popup = document.getElementById("goalSuccessPopup");
    const closeBtn = document.getElementById("closeGoalPopup");

    if (!input) return;

    function checkSuccess() {
        if (parseFloat(input.value) >= 100) {
            popup.classList.add("show");
        }
    }

    input.addEventListener("change", checkSuccess);

    if (closeBtn) {
        closeBtn.addEventListener("click", function () {
            popup.classList.remove("show");
        });
    }
});
</script>
{% endblock %}
