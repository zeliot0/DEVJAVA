{% extends 'base.html.twig' %}

{% block title %}Nexa AI - Commandeur d'Objectifs{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        :root {
            --ai-bg: #ffffff;
            --ai-sidebar-bg: #fcfcfc;
            --ai-accent: #0066ff;
            --ai-text-main: #0a0a0a;
            --ai-text-muted: #737373;
            --ai-border: rgba(0, 0, 0, 0.04);
        }

        /* Cartes de Statistiques */
        .stat-card {
            background: #ffffff;
            border-radius: 24px;
            padding: 24px;
            border: 1px solid var(--ai-border);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.02);
            transition: all 0.4s cubic-bezier(0.2, 0, 0, 1);
            position: relative;
            overflow: hidden;
        }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.04);
        }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
        }

        .card-blue::before { background: #3b82f6; }
        .card-purple::before { background: #8b5cf6; }
        .card-orange::before { background: #f59e0b; }
        .card-emerald::before { background: #10b981; }

        /* Table de Performance */
        .table-row {
            background: #ffffff;
            border-radius: 16px;
            transition: all 0.2s ease;
            border: 1px solid transparent;
        }

        .table-row:hover {
            background: #fafafa;
            border-color: var(--ai-border);
        }

        /* Badge Statut */
        .status-badge {
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.05em;
            padding: 4px 12px;
            border-radius: 8px;
            text-transform: uppercase;
        }

        /* Animations */
        .reveal { opacity: 0; transform: translateY(15px); }

        .no-scrollbar::-webkit-scrollbar { width: 0px; }
    </style>
{% endblock %}

{% block body %}
    {% set totalGoals = goals|length %}
    {% set totalProgress = 0 %}
    {% set highPriorityCount = 0 %}
    {% set draftCount = 0 %}
    {% for goal in goals %}
        {% set totalProgress = totalProgress + (goal.progressGoa|default(0)) %}
        {% if goal.priorityGoa == 'HAUTE' %}
            {% set highPriorityCount = highPriorityCount + 1 %}
        {% endif %}
        {% if goal.statusGoa|default('')|lower == 'brouillon' %}
            {% set draftCount = draftCount + 1 %}
        {% endif %}
    {% endfor %}
    {% set avgProgress = totalGoals > 0 ? (totalProgress / totalGoals)|round : 0 %}

    <!-- CONTENU PRINCIPAL -->
    <main class="flex-1 max-w-[1400px] mx-auto w-full py-8">
        
        <!-- TITRE SECTION -->
        <section class="reveal mb-12">
            <h1 class="text-5xl font-extrabold tracking-tight text-slate-900 mb-4 bg-clip-text text-transparent bg-gradient-to-r from-slate-900 to-indigo-500">
                Commandeur d'Objectifs
            </h1>
            <p class="text-slate-400 font-medium text-lg">
                Planification stratégique et orchestration des vecteurs de succès.
            </p>
        </section>

        <!-- TABS & ACTIONS -->
        <div class="reveal flex flex-wrap gap-3 mb-16 items-center">
            <a href="{{ path('app_milestones_index') }}" class="flex items-center gap-2 px-5 py-2.5 bg-slate-900 text-white rounded-xl text-sm font-bold shadow-xl shadow-slate-200 hover:bg-slate-800 transition-all no-underline">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 3h18v18H3z"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
                Jalons Opérationnels
            </a>
            <a href="{{ path('app_phoenix_goal_index') }}" class="flex items-center gap-2 px-5 py-2.5 bg-white border border-slate-100 text-slate-600 rounded-xl text-sm font-bold hover:bg-slate-50 transition-all no-underline">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                Protocole Phoenix
            </a>
            
            {% if not is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_goal_new') }}" class="flex items-center gap-2 px-5 py-2.5 bg-blue-600 text-white rounded-xl text-sm font-bold shadow-xl shadow-blue-100 hover:bg-blue-700 transition-all ml-auto no-underline">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Nouvel Objectif
                </a>
            {% endif %}
        </div>

        <!-- GRILLE DE STATISTIQUES -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-20">
            <div class="reveal stat-card card-blue">
                <span class="text-[10px] font-extrabold text-blue-500 uppercase tracking-widest block mb-4">Objectifs Actifs</span>
                <div class="flex items-end justify-between">
                    <span class="text-5xl font-extrabold text-slate-900">{{ totalGoals }}</span>
                    <span class="text-xs font-bold text-slate-400 mb-2">Instances globales</span>
                </div>
            </div>
            <div class="reveal stat-card card-purple">
                <span class="text-[10px] font-extrabold text-purple-500 uppercase tracking-widest block mb-4">Progression Moyenne</span>
                <div class="flex items-end justify-between">
                    <span class="text-5xl font-extrabold text-slate-900">{{ avgProgress }}%</span>
                    <span class="text-xs font-bold text-slate-400 mb-2">Vitesse systémique</span>
                </div>
            </div>
            <div class="reveal stat-card card-orange">
                <span class="text-[10px] font-extrabold text-orange-500 uppercase tracking-widest block mb-4">Risque Élevé</span>
                <div class="flex items-end justify-between">
                    <span class="text-5xl font-extrabold text-slate-900">{{ highPriorityCount }}</span>
                    <span class="text-xs font-bold text-slate-400 mb-2">Priorité HAUTE</span>
                </div>
            </div>
            <div class="reveal stat-card card-emerald">
                <span class="text-[10px] font-extrabold text-emerald-500 uppercase tracking-widest block mb-4">Brouillons</span>
                <div class="flex items-end justify-between">
                    <span class="text-5xl font-extrabold text-slate-900">{{ draftCount }}</span>
                    <span class="text-xs font-bold text-slate-400 mb-2">En attente d'initiation</span>
                </div>
            </div>
        </div>

        <!-- REPERTOIRE DE PERFORMANCE -->
        <section class="reveal">
            <div class="flex items-center gap-3 mb-8">
                <div class="w-1 h-6 bg-blue-600 rounded-full"></div>
                <h2 class="text-xs font-black text-blue-600 uppercase tracking-[0.2em]">Répertoire de Performance</h2>
            </div>

            <div class="w-full bg-white border border-slate-50 rounded-[32px] p-2 shadow-sm overflow-hidden">
                <table class="w-full text-left">
                    <thead>
                        <tr class="text-[11px] font-bold text-slate-300 uppercase tracking-widest">
                            <th class="px-8 py-6">DÉSIGNATION</th>
                            <th class="px-8 py-6">VALEUR / PRIO</th>
                            <th class="px-8 py-6">QUOTA (%)</th>
                            <th class="px-8 py-6 text-right">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        {% for goal in goals %}
                            {% set p = goal.progressGoa|default(0) %}
                            <tr class="table-row group">
                                <td class="px-8 py-8">
                                    {% set riskLevel = 'low' %}
                                    {% if goal.risks|length > 0 %}
                                        {% set maxScore = 0 %}
                                        {% for r in goal.risks %}
                                            {% if r.aiScore is not null and r.aiScore > maxScore %}{% set maxScore = r.aiScore %}{% endif %}
                                        {% endfor %}
                                        {% if maxScore >= 75 %}
                                            {% set riskLevel = 'high' %}
                                        {% elseif maxScore >= 30 %}
                                            {% set riskLevel = 'medium' %}
                                        {% else %}
                                            {% set riskLevel = 'low' %}
                                        {% endif %}
                                    {% endif %}

                                    <div class="flex items-center gap-5">
                                        <div class="w-2.5 h-2.5 rounded-full shadow-sm {{ goal.priorityGoa == 'HAUTE' ? 'bg-red-500' : (goal.priorityGoa == 'MOYENNE' ? 'bg-orange-400' : 'bg-emerald-400') }}"></div>
                                        <div>
                                            <h4 class="text-lg font-extrabold text-slate-900 m-0">{{ goal.titleGoa }}</h4>
                                            <p class="text-xs font-bold text-slate-300 mt-0.5 m-0">{{ goal.categoryGoa|default('Standard') }} • {{ goal.dateFinalGoa ? goal.dateFinalGoa|date('d M Y') : 'Sans échéance' }}</p>
                                        </div>
                                        <div title="Risque {{ riskLevel|upper }}" class="flex items-center" style="margin-left:8px; gap:4px;">
                                            {% if riskLevel == 'low' %}
                                                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-sm"></span>
                                            {% elseif riskLevel == 'medium' %}
                                                <span class="w-2.5 h-2.5 rounded-full bg-yellow-400 shadow-sm"></span>
                                            {% else %}
                                                <span class="w-2.5 h-2.5 rounded-full bg-red-500 shadow-sm"></span>
                                            {% endif %}
                                            <span class="text-xs text-slate-500">{{ riskLevel|capitalize }}</span>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-8 py-8">
                                    <span class="status-badge bg-slate-100 text-slate-500">
                                        {{ goal.statusGoa|default('ACTIF') }}
                                    </span>
                                </td>
                                <td class="px-8 py-8">
                                    <div class="flex items-center gap-4">
                                        <div class="w-24 h-1.5 bg-slate-100 rounded-full overflow-hidden">
                                            <div class="bg-indigo-600 h-full" style="width: {{ p }}%"></div>
                                        </div>
                                        <span class="text-sm font-black text-slate-900">{{ p }}%</span>
                                    </div>

                                    {% if goal.successScore is not null %}
                                        <div class="mt-2 flex items-center gap-4">
                                            <div class="w-24 h-1.5 bg-slate-100 rounded-full overflow-hidden">
                                                <div class="bg-emerald-500 h-full" style="width: {{ goal.successScore }}%"></div>
                                            </div>
                                            <span class="text-xs font-semibold text-slate-500">🎯 {{ goal.successScore }}%</span>
                                        </div>
                                    {% endif %}
                                </td>
                                <td class="px-8 py-8 text-right">
                                    <div class="inline-flex items-center gap-2">
                                        <a href="{{ path('app_goal_show', { 'id_g': goal.idGoa }) }}" class="inline-flex p-3 bg-slate-50 text-slate-400 rounded-xl hover:bg-slate-900 hover:text-white transition-all shadow-sm" title="Voir">
                                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                        </a>
                                        {% if not is_granted('ROLE_ADMIN') %}
                                            <form method="post" action="{{ path('app_goal_delete', { 'id_g': goal.idGoa }) }}" onsubmit="return confirm('Supprimer cet objectif ?');" class="inline-flex m-0">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ goal.idGoa) }}">
                                                <button type="submit" class="inline-flex p-3 bg-red-50 text-red-500 rounded-xl hover:bg-red-600 hover:text-white transition-all shadow-sm" title="Supprimer">
                                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"/><path d="M19 6l-1 14a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1L5 6"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="px-8 py-16 text-center text-slate-400 italic">Aucun objectif trouvé.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>

    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const tl = gsap.timeline({ defaults: { ease: "expo.out", duration: 1.2 } });

            // Séquence de révélation
            tl.to(".reveal", {
                opacity: 1,
                y: 0,
                stagger: 0.1,
                duration: 1.4
            });

            // Interaction sur les lignes du tableau
            document.querySelectorAll('.table-row').forEach(row => {
                row.addEventListener('mouseenter', () => {
                    gsap.to(row, { scale: 1.005, backgroundColor: "#fafbfc", duration: 0.3 });
                });
                row.addEventListener('mouseleave', () => {
                    gsap.to(row, { scale: 1, backgroundColor: "#ffffff", duration: 0.3 });
                });
            });
        });
    </script>
{% endblock %}
