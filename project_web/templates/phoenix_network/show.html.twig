{% extends 'base.html.twig' %}

{% set body_class = 'conscience-page' %}

{% block title %}CONNEXION #{{ phoenix_network.id }} — NEXA Intelligence{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/phoenix-network-modern.css?v=' ~ 'now'|date('U')) }}">
{% endblock %}

{% block body %}
<div class="net-page">

    <header class="net-header" style="text-align: left; display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 48px;">
        <div>
            <div style="font-size: 11px; font-weight: 800; color: var(--net-blue); text-transform: uppercase; letter-spacing: 0.2em; margin-bottom: 8px;">Analyse de Port</div>
            <h1 class="net-title" style="margin: 0;">Lien #{{ phoenix_network.id }}</h1>
        </div>
        <div style="display: flex; gap: 12px;">
            <a href="{{ path('app_phoenix_network_index') }}" class="btn">
                <i class="fas fa-arrow-left"></i> Répertoire
            </a>
            <a href="{{ path('app_phoenix_network_edit', {'id': phoenix_network.id}) }}" class="btn">
                <i class="fas fa-pen"></i> Édiion
            </a>
        </div>
    </header>

    <div class="net-detail-wrap">
        <div class="net-meta-grid">
            <div class="net-meta-item">
                <label>Typologie du Réseau</label>
                <div class="val" style="font-size: 24px; font-weight: 800; color: var(--net-blue);">{{ phoenix_network.networkType }}</div>
            </div>
            <div class="net-meta-item">
                <label>Instanciation Temporelle</label>
                <div class="val">{{ phoenix_network.connectedAt ? phoenix_network.connectedAt|date('d F Y H:i:s') : 'N/A' }}</div>
            </div>
        </div>

        <div style="margin-top: 60px; padding-top: 40px; border-top: 1px solid #f3f4f6; display: flex; justify-content: space-between; align-items: center;">
            <div style="display: flex; align-items: center; gap: 20px;">
                <div style="width: 56px; height: 56px; border-radius: 16px; background: #ecfdf5; color: #10b981; display: flex; align-items: center; justify-content: center; font-size: 22px;">
                    <i class="fa-solid fa-lock"></i>
                </div>
                <div>
                    <div style="font-size: 14px; font-weight: 800; color: #111827;">Cryptage Actif</div>
                    <div style="font-size: 13px; color: var(--notion-text-muted);">Ce lien est sécurisé par le protocole NEXA-Shield.</div>
                </div>
            </div>

            {{ include('phoenix_network/_delete_form.html.twig') }}
        </div>
    </div>

</div>
{% endblock %}
