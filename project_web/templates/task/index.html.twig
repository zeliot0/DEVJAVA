<script>
    // Integration logic for focus/music/analytics
    window.addEventListener('message', (event) => {
        if (event.data.type === 'nexa-focus-inline-close' || event.data.type === 'nexa-suite-inline-close') {
            const overlay = document.getElementById('focusInlineOverlay');
            const frame = document.getElementById('focusInlineFrame');
            overlay.hidden = true;
            frame.src = 'about:blank';
        }
    });

    document.addEventListener('click', (e) => {
        const focusBtn = e.target.closest('.focus-launch-btn');
        if (focusBtn) {
            e.preventDefault();
            const url = focusBtn.getAttribute('href');
            if (!url) return;
            const overlay = document.getElementById('focusInlineOverlay');
            const frame = document.getElementById('focusInlineFrame');
            frame.src = url + (url.includes('?') ? '&' : '?') + 'embed=1';
            overlay.hidden = false;
        }
        
        const musicBtn = e.target.closest('[data-suite-inline="music"]');
        if (musicBtn) {
            e.preventDefault();
            const url = musicBtn.getAttribute('href');
            if (!url) return;
            const overlay = document.getElementById('focusInlineOverlay');
            const frame = document.getElementById('focusInlineFrame');
            frame.src = url + (url.includes('?') ? '&' : '?') + 'embed=1';
            overlay.hidden = false;
        }
    });

    document.getElementById('focusInlineClose')?.addEventListener('click', () => {
        const overlay = document.getElementById('focusInlineOverlay');
        const frame = document.getElementById('focusInlineFrame');
        overlay.hidden = true;
        frame.src = 'about:blank';
    });

    // Template Gallery logic
    const tplOverlay = document.getElementById('templateOverlay');
    const newBtnSplit = document.getElementById('newBtnSplit');
    
    newBtnSplit?.addEventListener('click', (e) => {
        e.stopPropagation();
        tplOverlay.classList.add('open');
    });
    
    [tplOverlay, document.getElementById('closeTemplates')].forEach(el => {
        el?.addEventListener('click', (e) => {
            if (e.target === tplOverlay || e.target.closest('#closeTemplates')) {
                tplOverlay.classList.remove('open');
            }
        });
    });

    // Functional Template Generation
    document.querySelectorAll('[data-template]').forEach(card => {
        card.addEventListener('click', async () => {
            const templateType = card.dataset.template;
            tplOverlay.classList.remove('open');
            
            // Show thinking indicator
            const thinking = document.getElementById('aiThinkingIndicator');
            if (thinking) thinking.style.display = 'flex';

            try {
                const templates = {
                    'empty': [],
                    'tasks': [
                        { title: 'Configuration du projet', status: 'todo', priority: 'high', description: 'Initialiser les paramètres de base.' },
                        { title: 'Réunion d\'équipe', status: 'todo', priority: 'med', description: 'Synchronisation hebdomadaire.' },
                        { title: 'Analyse des besoins', status: 'doing', priority: 'high', description: 'Étude détaillée des spécifications.' }
                    ],
                    'projects': [
                        { title: 'Définition du périmètre', status: 'todo', priority: 'high', description: 'Validation des jalons.' },
                        { title: 'Sprint Planning', status: 'doing', priority: 'med', description: 'Répartition des ressources.' }
                    ],
                    'docs': [
                        { title: 'Rédaction documentation technique', status: 'todo', priority: 'low', description: 'Mise à jour du Wiki.' },
                        { title: 'Revue de presse', status: 'done', priority: 'low' }
                    ],
                    'brainstorm': [
                        { title: 'Idéation Produit 2024', status: 'todo', priority: 'high', description: 'Session créative.' }
                    ]
                };

                const data = templates[templateType] || [];
                
                for (const task of data) {
                    await fetch(window.NEXA_API.create, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(task)
                    });
                }

                if (window.refreshTasks) await window.refreshTasks();
                if (window.render) window.render();
                
                showToast({ type: 'success', title: 'Modèle appliqué', message: 'Votre espace a été initialisé 🚀' });
            } catch (err) {
                console.error('Template Error:', err);
            } finally {
                if (thinking) thinking.style.display = 'none';
            }
        });
    });

    // ==========================================
    // ZEN PULSE LOGIC (Pomodoro)
    // ==========================================
    let zenSeconds = 25 * 60;
    let zenInterval = null;
    let isZenRunning = false;
    const initialSeconds = 25 * 60;

    const zenClock = document.getElementById('zenClock');
    const timerProgress = document.getElementById('timerProgress');
    const toggleZen = document.getElementById('toggleZen');
    const zenStatus = document.getElementById('zenStatus');

    function updateZenUI() {
        const mins = Math.floor(zenSeconds / 60);
        const secs = zenSeconds % 60;
        if (zenClock) zenClock.textContent = `${mins}:${secs.toString().padStart(2, '0')}`;
        
        if (timerProgress) {
            const offset = 125.6 - (125.6 * (zenSeconds / initialSeconds));
            timerProgress.style.strokeDashoffset = offset;
        }
    }

    toggleZen?.addEventListener('click', () => {
        isZenRunning = !isZenRunning;
        if (isZenRunning) {
            toggleZen.innerHTML = '<i class="fa-solid fa-pause"></i>';
            if (zenStatus) zenStatus.textContent = "Focus en cours...";
            zenInterval = setInterval(() => {
                zenSeconds--;
                if (zenSeconds <= 0) {
                    clearInterval(zenInterval);
                    confetti({ particleCount: 150, spread: 70, origin: { y: 0.6 } });
                    zenSeconds = initialSeconds;
                    isZenRunning = false;
                    toggleZen.innerHTML = '<i class="fa-solid fa-play"></i>';
                    if (zenStatus) zenStatus.textContent = "Session Terminée !";
                }
                updateZenUI();
            }, 1000);
        } else {
            toggleZen.innerHTML = '<i class="fa-solid fa-play"></i>';
            if (zenStatus) zenStatus.textContent = "Focus en pause";
            clearInterval(zenInterval);
        }
    });

    // ==========================================
    // MUSIC PULSE LOGIC
    // ==========================================
    const musicWidget = document.getElementById('musicWidget');
    const toggleMusic = document.getElementById('toggleMusic');
    const musicTrackName = document.getElementById('musicTrackName');
    let isMusicPlaying = false;
    let audioInst = null;

    const tracks = [
        { name: "Lofi Study", url: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3" },
        { name: "Ambient Flow", url: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-2.mp3" },
        { name: "Deep Focus", url: "https://www.soundhelix.com/examples/mp3/SoundHelix-Song-3.mp3" }
    ];
    let currentIdx = 0;

    toggleMusic?.addEventListener('click', (e) => {
        e.stopPropagation();
        isMusicPlaying = !isMusicPlaying;
        if (isMusicPlaying) {
            if (!audioInst) audioInst = new Audio(tracks[currentIdx].url);
            audioInst.play();
            toggleMusic.innerHTML = '<i class="fa-solid fa-pause"></i>';
            if (musicTrackName) musicTrackName.textContent = tracks[currentIdx].name;
            showToast({ type: 'info', title: 'Musique', message: 'Session audio lancée 🎵' });
        } else {
            audioInst?.pause();
            toggleMusic.innerHTML = '<i class="fa-solid fa-play"></i>';
        }
    });

    // Cycle track on widget click (not on play button)
    musicWidget?.addEventListener('click', (e) => {
        if (!e.target.closest('#toggleMusic')) {
            currentIdx = (currentIdx + 1) % tracks.length;
            if (musicTrackName) musicTrackName.textContent = tracks[currentIdx].name;
            if (isMusicPlaying) {
                audioInst.pause();
                audioInst = new Audio(tracks[currentIdx].url);
                audioInst.play();
            }
        }
    });

    // ==========================================
    // COMMAND PALETTE LOGIC
    // ==========================================
    const cmdOverlay = document.getElementById('cmdOverlay');
    const cmdInput = document.getElementById('commandInput');

    document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
            e.preventDefault();
            cmdOverlay?.classList.add('open');
            cmdInput?.focus();
        }
        if (e.key === 'Escape') {
            cmdOverlay?.classList.remove('open');
        }
        
        // Quick shortcuts when palette is open
        if (cmdOverlay?.classList.contains('open')) {
            if (e.key.toLowerCase() === 'n') { document.getElementById('newBtn')?.click(); cmdOverlay.classList.remove('open'); }
            if (e.key.toLowerCase() === 'f') { toggleZen?.click(); cmdOverlay.classList.remove('open'); }
            if (e.key.toLowerCase() === 'm') { window.location.href = '/notion/music'; }
        }
    });

    cmdOverlay?.addEventListener('click', (e) => {
        if (e.target === cmdOverlay) cmdOverlay.classList.remove('open');
    });

    // ==========================================
    // AI SMART INSIGHTS DYNAMICS
    // ==========================================
    function updateAiInsights() {
        const insightEl = document.getElementById('aiInsightText');
        if (!insightEl) return;

        const highPrio = document.querySelectorAll('.notion-task-tag.high').length;
        const totalTasks = document.querySelectorAll('.notion-task-card').length;
        const doneTasks = document.querySelectorAll('.notion-column#zone-done .notion-task-card').length;

        let message = "Analyse Nexa AI en cours...";
        if (highPrio > 3) {
            message = "⚠️ Alerte Charge : Vous avez beaucoup de tâches prioritaires. Nexa suggère d'utiliser le mode Focus pour la plus critique.";
        } else if (doneTasks > 0 && doneTasks >= totalTasks * 0.5) {
            message = "🏆 Productivité au top ! Plus de la moitié de vos tâches sont terminées. C'est le moment idéal pour planifier demain.";
        } else if (totalTasks > 10) {
            message = "📚 Votre tableau est bien rempli. Pensez à archiver ou supprimer les tâches obsolètes pour garder l'esprit clair.";
        } else {
            message = "🌱 Votre espace est serein. C'est un excellent moment pour une session d'idéation ou de documentation.";
        }
        insightEl.textContent = message;
    }

    // Hook into card refresh for automatic celebration
    const originalRefresh = window.refreshTasks;
    window.refreshTasks = async function() {
        if (originalRefresh) await originalRefresh();
        
        // Check for new completions
        const currentDone = document.querySelectorAll('.notion-column#zone-done .notion-task-card').length;
        if (window._lastDoneCount !== undefined && currentDone > window._lastDoneCount) {
            confetti({
                particleCount: 80,
                spread: 60,
                origin: { y: 0.7 },
                colors: ['#6366f1', '#a855f7', '#10b981']
            });
            showToast({ type: 'success', title: 'Tâche Terminée !', message: 'Bravo pour votre efficacité 🌟' });
        }
        window._lastDoneCount = currentDone;
        updateAiInsights();
    };

    // Initializations
    setTimeout(() => {
        window._lastDoneCount = document.querySelectorAll('.notion-column#zone-done .notion-task-card').length;
        updateAiInsights();
        updateZenUI();
    }, 1500);

    // Command palette item clicks
    document.querySelectorAll('.command-item').forEach(item => {
        item.addEventListener('click', () => {
            const action = item.dataset.action;
            cmdOverlay?.classList.remove('open');
            if (action === 'new-task') document.getElementById('newBtn')?.click();
            if (action === 'focus') toggleZen?.click();
            if (action === 'music') window.location.href = '/notion/music';
            if (action === 'theme') document.getElementById('themeToggle')?.click();
        });
    });

    // ==========================================
    // DRAGGABLE WIDGETS LOGIC
    // ==========================================
    function makeDraggable(el) {
        let pos1 = 0, pos2 = 0, pos3 = 0, pos4 = 0;
        let startX = 0, startY = 0;
        let moved = false;
        
        el.onmousedown = dragMouseDown;

        function dragMouseDown(e) {
            // Don't drag if clicking buttons
            if (e.target.closest('button')) return;
            
            e = e || window.event;
            e.preventDefault();
            startX = e.clientX;
            startY = e.clientY;
            pos3 = e.clientX;
            pos4 = e.clientY;
            moved = false;
            
            document.onmouseup = closeDragElement;
            document.onmousemove = elementDrag;
            el.style.transition = 'none';
        }

        function elementDrag(e) {
            e = e || window.event;
            e.preventDefault();
            
            const dist = Math.sqrt(Math.pow(e.clientX - startX, 2) + Math.pow(e.clientY - startY, 2));
            if (dist > 5) moved = true;

            pos1 = pos3 - e.clientX;
            pos2 = pos4 - e.clientY;
            pos3 = e.clientX;
            pos4 = e.clientY;
            
            let newTop = el.offsetTop - pos2;
            let newLeft = el.offsetLeft - pos1;

            const pad = 10;
            if (newTop < pad) newTop = pad;
            if (newLeft < pad) newLeft = pad;
            if (newTop + el.offsetHeight > window.innerHeight - pad) newTop = window.innerHeight - el.offsetHeight - pad;
            if (newLeft + el.offsetWidth > window.innerWidth - pad) newLeft = window.innerWidth - el.offsetWidth - pad;

            el.style.top = newTop + "px";
            el.style.left = newLeft + "px";
            el.style.bottom = "auto";
            el.style.right = "auto";
        }

        function closeDragElement(e) {
            document.onmouseup = null;
            document.onmousemove = null;
            el.style.transition = 'all 0.3s ease';

            // If it wasn't a drag, it's a click: Open module
            if (!moved) {
                const url = el.dataset.href;
                if (url) {
                    const overlay = document.getElementById('focusInlineOverlay');
                    const frame = document.getElementById('focusInlineFrame');
                    if (overlay && frame) {
                        frame.src = url + (url.includes('?') ? '&' : '?') + 'embed=1';
                        overlay.hidden = false;
                    }
                }
            }
        }
    }

    function makeResizable(el) {
        const handle = el.querySelector('.resize-handle');
        if (!handle) return;
        
        handle.addEventListener('mousedown', (e) => {
            e.preventDefault();
            e.stopPropagation();
            
            const startWidth = el.offsetWidth;
            const startX = e.clientX;
            
            function onMouseMove(e) {
                const newWidth = startWidth + (e.clientX - startX);
                el.style.width = newWidth + 'px';
            }
            
            function onMouseUp() {
                document.removeEventListener('mousemove', onMouseMove);
                document.removeEventListener('mouseup', onMouseUp);
            }
            
            document.addEventListener('mousemove', onMouseMove);
            document.addEventListener('mouseup', onMouseUp);
        });
    }

    // Apply draggability & resizability
    const zenW = document.getElementById('zenWidget');
    const musW = document.getElementById('musicWidget');
    if (zenW) {
        makeDraggable(zenW);
        makeResizable(zenW);
    }
    if (musW) {
        makeDraggable(musW);
        makeResizable(musW);
    }
</script>
{% endblock %}
