{% extends 'theme/base.html.twig' %}

{% block title %}Modifier Produit — NEXA{% endblock %}

{% block body %}
{% set __referer = app.request.headers.get('referer')|default('') %}
{% set __host = app.request.schemeAndHttpHost|default('') %}
{% set backUrl = (__referer and __host and (__referer starts with __host)) ? __referer : null %}

<!-- ================= HEADER ================= -->
<div class="page-header">
    <div>
        <h1>Modifier le produit</h1>
        <p>Mettre à jour les informations du produit</p>
    </div>

    <a href="{{ backUrl ?: path('app_produit_index') }}" class="btn">
        <i class="fa-solid fa-arrow-left"></i>
        Retour
    </a>
</div>

<div class="form-shell">
    <div class="form-card">
        {{ include('produit/_form.html.twig', {'button_label': 'Mettre à jour'}) }}

        <div class="form-actions" style="justify-content:flex-start">
            {{ include('produit/_delete_form.html.twig') }}
        </div>

    </div>
</div>

{% endblock %}

